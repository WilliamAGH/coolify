[Unit]
Description=Restore the Coolify control-plane container-to-host SSH fence
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target docker.service docker.socket
PartOf=docker.service docker.socket

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/coolify-runtime-attestation-ssh-fence/runtime.env
ExecStart=/usr/local/libexec/coolify-runtime-attestation-ssh-fence restore
RemainAfterExit=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/coolify-runtime-attestation-ssh-fence
RestrictAddressFamilies=AF_NETLINK AF_UNIX
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN

[Install]
RequiredBy=docker.service docker.socket
