[Unit]
Description=Continuously reconcile the armed Coolify control-plane SSH fence
After=docker.service
BindsTo=docker.service
PartOf=docker.service

[Service]
Type=simple
User=root
Group=root
RuntimeDirectory=coolify-control-plane-release-dispatch
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
EnvironmentFile=/etc/coolify-runtime-attestation-ssh-fence/runtime.env
ExecStart=/usr/local/libexec/coolify-control-plane-release-dispatch runtime-fence-controller watch
Restart=always
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/coolify-runtime-attestation-ssh-fence
ReadWritePaths=/run/coolify-control-plane-release-dispatch
ReadWritePaths=/run/lock
ReadWritePaths=/etc/coolify-control-plane
ReadWritePaths=/etc/systemd/system
ReadWritePaths=/usr/local/libexec
ReadWritePaths=/usr/local/sbin
RestrictAddressFamilies=AF_NETLINK AF_UNIX
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN

[Install]
WantedBy=docker.service
