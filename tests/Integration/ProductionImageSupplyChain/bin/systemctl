#!/bin/sh

set -eu

if [ "${1:-}" = is-enabled ] && [ "${2:-}" = --quiet ]; then
    case "${3:-}" in
        coolify-port8000-haproxy@phase-a.service|coolify-port8000-haproxy@phase-b.service|coolify-port8000-phase-b-authorizer.service|coolify-port8000-nft.service)
            exit 0
            ;;
    esac
fi

exit 1
