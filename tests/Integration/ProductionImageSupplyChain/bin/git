#!/bin/sh

set -eu

[ "$#" -eq 5 ] || exit 64
[ "$1" = ls-remote ] || exit 64
[ "$2" = --tags ] || exit 64

repository=$3
tag_reference=$4

case "$repository:$tag_reference" in
    https://github.com/docker/cli.git:refs/tags/v28.4.0)
        commit=d8eb465f86cfceeb57f8582e373d41a558d35503
        ;;
    https://github.com/docker/compose.git:refs/tags/v2.39.2)
        commit=c2cb0aef6bbbe1afc8c9e81267621655ac90c5f6
        ;;
    https://github.com/docker/buildx.git:refs/tags/v0.29.1)
        commit=a32761aeb3debd39be1eca514af3693af0db334b
        ;;
    https://github.com/cloudflare/cloudflared.git:refs/tags/2026.7.1)
        commit=ecb88678f1368581964ca2bb55615502a2ed2dbe
        ;;
    *)
        exit 0
        ;;
esac

if [ "${PRODUCTION_IMAGE_SUPPLY_CHAIN_SIMULATION_MISMATCH:-0}" = 1 ]; then
    commit=0000000000000000000000000000000000000000
fi

printf '%s\t%s^{}\n' "$commit" "$tag_reference"
