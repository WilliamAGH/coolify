#!/usr/bin/env python3

import fcntl
import sys
import time


def acquire_with_timeout(file_descriptor: int, timeout_seconds: float) -> int:
    deadline = time.monotonic() + timeout_seconds
    while True:
        try:
            fcntl.flock(file_descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return 0
        except BlockingIOError:
            if time.monotonic() >= deadline:
                return 1
            time.sleep(min(0.05, max(0, deadline - time.monotonic())))
        except OSError as error:
            print(f"flock: descriptor {file_descriptor}: {error.strerror}", file=sys.stderr)
            return 64


def main() -> int:
    if len(sys.argv) == 4 and sys.argv[1] == "-w":
        try:
            timeout_seconds = float(sys.argv[2])
            file_descriptor = int(sys.argv[3])
        except ValueError:
            return 64
        if timeout_seconds < 0:
            return 64
        return acquire_with_timeout(file_descriptor, timeout_seconds)

    if len(sys.argv) != 3 or sys.argv[1] not in {"-n", "-u"}:
        return 64

    file_descriptor = int(sys.argv[2])
    operation = fcntl.LOCK_UN if sys.argv[1] == "-u" else fcntl.LOCK_EX | fcntl.LOCK_NB
    try:
        fcntl.flock(file_descriptor, operation)
    except BlockingIOError:
        return 1
    except OSError as error:
        print(f"flock: descriptor {file_descriptor}: {error.strerror}", file=sys.stderr)
        return 64

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
