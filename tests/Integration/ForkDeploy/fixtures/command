#!/usr/bin/env bash

set -Eeuo pipefail
name=${0##*/}
{
    printf '%s' "$name"
    printf ' %q' "$@"
    printf '\n'
} >>"$FORK_DEPLOY_TEST_LOG"

control_plane_listener_override_is_active() {
    local path=$1

    [[ -f $path && ! -L $path ]] || return 1
    awk '
        $0 ~ /^  coolify:[[:space:]]*$/ { in_coolify = 1; next }
        in_coolify && $0 ~ /^  [^[:space:]]/ { exit }
        in_coolify && $0 ~ /^    ports:[[:space:]]*!reset[[:space:]]*\[\][[:space:]]*$/ {
            found = 1
            exit
        }
        END { exit !found }
    ' "$path"
}

compose_uses_control_plane_listener_override() {
    local argument previous='' listener_override=''

    for argument in "$@"; do
        if [[ $previous == --file || $previous == -f ]]; then
            if [[ $argument == */docker-compose.control-plane-listener.yml ]]; then
                listener_override=$argument
            fi
            previous=
            continue
        fi
        case $argument in
            --file|-f) previous=$argument ;;
        esac
    done
    [[ -n $listener_override ]] && control_plane_listener_override_is_active "$listener_override"
}

compose_uses_legacy_current() {
    local argument previous='' environment=''

    [[ ${FORK_DEPLOY_LEGACY_CURRENT:-false} == true ]] || return 1
    [[ ! -e ${FORK_DEPLOY_CANDIDATE_STARTED_MARKER:-/nonexistent} ]] || return 1
    for argument in "$@"; do
        if [[ $previous == --env-file ]]; then
            environment=$argument
            break
        fi
        [[ $argument == --env-file ]] && previous=--env-file
    done
    [[ $environment == "${FORK_DEPLOY_ACTIVE_SOURCE:-/nonexistent}/.env" ]]
}

compose_uses_selected_environment() {
    local argument previous='' environment=''

    for argument in "$@"; do
        if [[ $previous == --env-file ]]; then
            environment=$argument
            break
        fi
        [[ $argument == --env-file ]] && previous=--env-file
    done
    [[ -n $environment && ${COOLIFY_ENV_FILE:-} == "$environment" ]]
}

legacy_runtime_is_active() {
    [[ ${FORK_DEPLOY_LEGACY_CURRENT:-false} == true \
        && ! -e ${FORK_DEPLOY_CANDIDATE_STARTED_MARKER:-/nonexistent} ]]
}

case $name in
    uname)
        if [[ ${1:-} == -s ]]; then printf 'Linux\n'; else printf 'x86_64\n'; fi
        ;;
    openssl)
        if [[ ${1:-} == pkeyutl ]]; then
            if [[ ${FORK_DEPLOY_USE_REAL_OPENSSL:-false} == true ]]; then
                "$FORK_DEPLOY_REAL_OPENSSL" "$@"
            else
                [[ ${FORK_DEPLOY_OPENSSL_VERIFY_FAIL:-false} != true ]]
            fi
        else
            "$FORK_DEPLOY_REAL_OPENSSL" "$@"
        fi
        ;;
    chown)
        ;;
    ssh-keygen)
        if [[ ${1:-} == -y ]]; then
            printf 'ssh-ed25519 fixture-public-key\n'
        else
            output=
            while (($#)); do
                if [[ $1 == -f ]]; then output=$2; shift 2; else shift; fi
            done
            printf 'fixture-private-key\n' >"$output"
            printf 'ssh-ed25519 fixture-public-key coolify\n' >"$output.pub"
        fi
        ;;
    sleep)
        ;;
    curl)
        output=
        while (($#)); do
            if [[ $1 == --output ]]; then output=$2; shift 2; else shift; fi
        done
        case $output in
            */docker-compose.yml) printf 'services: {}\n' >"$output" ;;
            */docker-compose.prod.yml) printf 'services: {}\n' >"$output" ;;
            */.env.production) printf 'DB_USERNAME=coolify\nDB_DATABASE=coolify\n%s' "${FORK_DEPLOY_ENV_EXTRA:-}" >"$output" ;;
            *) exit 2 ;;
        esac
        ;;
    docker)
        case ${1:-} in
            info)
                [[ ${FORK_DEPLOY_DOCKER_UNAVAILABLE:-false} != true ]]
                ;;
            compose)
                if [[ ${2:-} == version ]]; then
                    if [[ ${3:-} == --short ]]; then printf '%s\n' "${FORK_DEPLOY_COMPOSE_VERSION:-v2.24.4}"; fi
                    exit 0
                fi
                if [[ ${FORK_DEPLOY_REQUIRE_COMPOSE_ENV_PATH:-false} == true ]] \
                    && ! compose_uses_selected_environment "$@"; then
                    exit 1
                fi
                listener_override_active=false
                if compose_uses_control_plane_listener_override "$@"; then
                    listener_override_active=true
                fi
                legacy_current=false
                if compose_uses_legacy_current "$@"; then
                    legacy_current=true
                fi
                if [[ $* == *' up '* ]]; then
                    [[ ${FORK_DEPLOY_FAIL_COMPOSE_UP:-false} != true ]] || exit 1
                    : >"$FORK_DEPLOY_RUNTIME_MARKER"
                    : >"${FORK_DEPLOY_CANDIDATE_STARTED_MARKER:-$FORK_DEPLOY_RUNTIME_MARKER}"
                    : >"${FORK_DEPLOY_DB_MARKER:-$FORK_DEPLOY_RUNTIME_MARKER}"
                    : >"${FORK_DEPLOY_REDIS_MARKER:-$FORK_DEPLOY_RUNTIME_MARKER}"
                fi
                if [[ $* == *' config'* && $* == *--quiet* \
                    && $* == *"${FORK_DEPLOY_ACTIVE_SOURCE:-/nonexistent}"* \
                    && ${FORK_DEPLOY_KILL_ON_ACTIVE_CONFIG:-false} == true ]]; then
                    kill -KILL "$PPID"
                    exit 137
                fi
                if [[ $* == *' config'* && $* == *--quiet* \
                    && $* == *"${FORK_DEPLOY_ACTIVE_SOURCE:-/nonexistent}"* \
                    && ${FORK_DEPLOY_FAIL_ACTIVATED_CONFIG:-false} == true ]]; then
                    exit 1
                fi
                if [[ $* == *'--format json'* ]]; then
                    if "$legacy_current" && "$listener_override_active"; then
                        printf '%s\n' '{"services":{"coolify":{"ports":[]},"soketi":{"ports":[{"host_ip":"127.0.0.1","published":"6001","target":6001},{"host_ip":"127.0.0.1","published":"6002","target":6002}]}}}'
                    elif "$legacy_current"; then
                        printf '%s\n' '{"services":{"coolify":{"ports":[{"host_ip":"0.0.0.0","published":"8000","target":8080}]},"soketi":{"ports":[{"host_ip":"127.0.0.1","published":"6001","target":6001},{"host_ip":"127.0.0.1","published":"6002","target":6002}]}}}'
                    elif "$listener_override_active"; then
                        printf '%s\n' '{"services":{"coolify":{"ports":[]}}}'
                    elif [[ ${FORK_DEPLOY_COMPOSE_SWAP_BINDINGS:-false} == true ]]; then
                        printf '%s\n' '{"services":{"coolify":{"ports":[{"host_ip":"127.0.0.1","published":"6001","target":8080},{"host_ip":"0.0.0.0","published":"8000","target":6001},{"host_ip":"127.0.0.1","published":"6002","target":6002}]}}}'
                    else
                        app_host_field='"host_ip":"0.0.0.0",'
                        if [[ ${FORK_DEPLOY_COMPOSE_APP_LOOPBACK:-false} == true ]]; then app_host_field='"host_ip":"127.0.0.1",'; fi
                        if [[ ${FORK_DEPLOY_COMPOSE_OMIT_APP_HOST_IP:-false} == true ]]; then app_host_field=; fi
                        printf '{"services":{"coolify":{"ports":[{%s"published":"8000","target":8080},{"host_ip":"127.0.0.1","published":"6001","target":6001},{"host_ip":"127.0.0.1","published":"6002","target":6002}]}}}\n' "$app_host_field"
                    fi
                elif [[ $* == *--images* ]]; then
                    if "$legacy_current"; then
                        printf '%s\n' \
                            'docker.iocloudhost.net/williamagh/coolify@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' \
                            'docker.iocloudhost.net/williamagh/coolify-realtime@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb' \
                            'docker.io/library/postgres@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc' \
                            'docker.io/library/redis@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd'
                    else
                        printf '%s\n' \
                            'docker.iocloudhost.net/williamagh/coolify@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' \
                            'docker.io/library/postgres@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc' \
                            'docker.io/library/redis@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd'
                    fi
                elif [[ $* == *' config'* && $* != *--quiet* ]]; then
                    previous=
                    for argument in "$@"; do
                        if [[ $previous == --env-file ]]; then cat "$argument"; break; fi
                        previous=$argument
                    done
                fi
                exit 0
                ;;
            container)
                case ${2:-} in
                    inspect)
                        [[ ${3:-} == coolify-realtime && -e ${FORK_DEPLOY_LEGACY_REALTIME_MARKER:-/nonexistent} ]]
                        ;;
                    stop)
                        [[ ${3:-} == coolify-realtime \
                            && -e ${FORK_DEPLOY_LEGACY_REALTIME_MARKER:-/nonexistent} ]] || exit 64
                        : >"${FORK_DEPLOY_LEGACY_REALTIME_STOPPED_MARKER:-/nonexistent}"
                        ;;
                    rm)
                        [[ ${*: -1} == coolify-realtime ]] || exit 64
                        [[ ${FORK_DEPLOY_FAIL_LEGACY_REALTIME_REMOVE:-false} != true ]] || exit 1
                        rm -f "${FORK_DEPLOY_LEGACY_REALTIME_MARKER:-/nonexistent}"
                        rm -f "${FORK_DEPLOY_LEGACY_REALTIME_STOPPED_MARKER:-/nonexistent}"
                        ;;
                    *) exit 64 ;;
                esac
                ;;
            pull) exit 0 ;;
            image)
                if [[ $* == *Architecture* ]]; then printf 'amd64\n'; else printf 'linux\n'; fi
                ;;
            network) exit 0 ;;
            volume)
                if [[ ${2:-} == ls && ${3:-} == --format && -n ${FORK_DEPLOY_LEGACY_VOLUMES:-} ]]; then
                    printf '%s\n' "$FORK_DEPLOY_LEGACY_VOLUMES"
                fi
                exit 0
                ;;
            inspect)
                inspected=${*: -1}
                case $inspected in
                    coolify)
                        [[ -e ${FORK_DEPLOY_RUNTIME_MARKER:-/nonexistent} ]] || exit 1
                        ;;
                    coolify-realtime) [[ -e ${FORK_DEPLOY_LEGACY_REALTIME_MARKER:-/nonexistent} ]] || exit 1 ;;
                    coolify-db) [[ -e ${FORK_DEPLOY_DB_MARKER:-${FORK_DEPLOY_RUNTIME_MARKER:-/nonexistent}} ]] || exit 1 ;;
                    coolify-redis) [[ -e ${FORK_DEPLOY_REDIS_MARKER:-${FORK_DEPLOY_RUNTIME_MARKER:-/nonexistent}} ]] || exit 1 ;;
                esac
                if [[ $* == *NetworkSettings.Ports* ]]; then
                    if [[ ${FORK_DEPLOY_HOST_IP:-} == absent ]]; then exit 1; fi
                    case ${*: -1} in
                        coolify)
                            if ! control_plane_listener_override_is_active "${FORK_DEPLOY_ACTIVE_SOURCE:-/nonexistent}/docker-compose.control-plane-listener.yml"; then
                                host_ip=${FORK_DEPLOY_APP_HOST_IP:-${FORK_DEPLOY_HOST_IP:-0.0.0.0}}
                                printf '8080/tcp\t%s\t%s\n' "$host_ip" "${FORK_DEPLOY_APP_PORT:-8000}"
                                if [[ ${FORK_DEPLOY_APP_DUAL_STACK:-false} == true ]]; then
                                    printf '8080/tcp\t::\t%s\n' "${FORK_DEPLOY_APP_PORT:-8000}"
                                fi
                                if ! legacy_runtime_is_active; then
                                    pusher_host_ip=${FORK_DEPLOY_PUSHER_HOST_IP:-${FORK_DEPLOY_HOST_IP:-127.0.0.1}}
                                    terminal_host_ip=${FORK_DEPLOY_TERMINAL_HOST_IP:-${FORK_DEPLOY_HOST_IP:-127.0.0.1}}
                                    printf '6001/tcp\t%s\t%s\n' "$pusher_host_ip" "${FORK_DEPLOY_PUSHER_PORT:-6001}"
                                    printf '6002/tcp\t%s\t%s\n' "$terminal_host_ip" "${FORK_DEPLOY_TERMINAL_PORT:-6002}"
                                fi
                            fi
                            ;;
                        coolify-realtime)
                            if legacy_runtime_is_active; then
                                printf '6001/tcp\t127.0.0.1\t6001\n'
                                printf '6002/tcp\t127.0.0.1\t6002\n'
                            fi
                            ;;
                        *)
                            host_ip=${FORK_DEPLOY_HOST_IP:-127.0.0.1}
                            if [[ ${FORK_DEPLOY_EXTRA_BINDING:-false} == true ]]; then printf '9999/tcp\t%s\t9999\n' "$host_ip"; fi
                            ;;
                    esac
                elif [[ $* == *State.Running* ]]; then
                    printf 'true\n'
                elif [[ $* == *Config.Image* ]]; then
                    if [[ ${FORK_DEPLOY_FAIL_CANDIDATE_RUNTIME_VERIFY:-false} == true \
                        && -e ${FORK_DEPLOY_CANDIDATE_STARTED_MARKER:-/nonexistent} \
                        && ${*: -1} == coolify ]]; then
                        printf 'docker.iocloudhost.net/williamagh/coolify@sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff\n'
                        exit 0
                    fi
                    if [[ ${FORK_DEPLOY_FAIL_LEGACY_RUNTIME_VERIFY:-false} == true \
                        && ${*: -1} == coolify-realtime ]] \
                        && legacy_runtime_is_active; then
                        printf 'docker.iocloudhost.net/williamagh/coolify-realtime@sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff\n'
                        exit 0
                    fi
                    case ${*: -1} in
                        coolify-realtime) printf 'docker.iocloudhost.net/williamagh/coolify-realtime@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\n' ;;
                        coolify-db) printf 'docker.io/library/postgres@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\n' ;;
                        coolify-redis) printf 'docker.io/library/redis@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd\n' ;;
                        *) printf 'docker.iocloudhost.net/williamagh/coolify@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n' ;;
                    esac
                else
                    printf 'healthy\n'
                fi
                ;;
            exec)
                if [[ $* == *'curl '* ]]; then
                    [[ ${FORK_DEPLOY_FAIL_BUNDLED_ROUTE_PROOF:-false} != true ]] || exit 1
                    if [[ -n ${FORK_DEPLOY_BUNDLED_ROUTE_FAILURES:-} ]]; then
                        attempts=0
                        if [[ -f ${FORK_DEPLOY_BUNDLED_ROUTE_ATTEMPTS_FILE:-/nonexistent} ]]; then
                            attempts=$(<"$FORK_DEPLOY_BUNDLED_ROUTE_ATTEMPTS_FILE")
                        fi
                        attempts=$((attempts + 1))
                        printf '%s\n' "$attempts" >"$FORK_DEPLOY_BUNDLED_ROUTE_ATTEMPTS_FILE"
                        ((attempts > FORK_DEPLOY_BUNDLED_ROUTE_FAILURES)) || exit 1
                    fi
                    [[ $* == *'http://127.0.0.1:6001/up'* \
                        || $* == *'http://127.0.0.1:6002/ready'* ]] || exit 64
                elif [[ $* == *to_regclass* ]]; then
                    if [[ -n ${FORK_DEPLOY_MIGRATION_FINGERPRINT:-} ]]; then printf 'migrations\n'; else printf '\n'; fi
                else
                    printf '%s\n' "${FORK_DEPLOY_MIGRATION_FINGERPRINT:-d41d8cd98f00b204e9800998ecf8427e}"
                fi
                ;;
            ps) printf 'coolify Up healthy\n';;
        esac
        ;;
esac
