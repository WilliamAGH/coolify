#!/usr/bin/env bash

set -Eeuo pipefail
name=${0##*/}
{
    printf '%s' "$name"
    printf ' %q' "$@"
    printf '\n'
} >>"$FORK_DEPLOY_TEST_LOG"

case $name in
    control-plane-blue-green)
        [[ ${1:-} == backup-quiesce ]]
        action=${2:-}
        operation_id=${4:-}
        fencing_token=${6:-}
        fencing_sha=$(printf '%s' "$fencing_token" | sha256sum | awk '{print $1}')
        case $action in
            acquire)
                [[ ! -e $FORK_DEPLOY_QUIESCE_MARKER ]]
                acquired=$(date +%s)
                expires=$((acquired + 1800))
                printf '%s:%s:%s\n' "$operation_id" "$acquired" "$expires" >"$FORK_DEPLOY_QUIESCE_MARKER"
                printf 'backup-quiesce=acquired;operation_id=%s;fencing_token_sha256=%s;lease_acquired_unix=%s;lease_expires_unix=%s\n' \
                    "$operation_id" "$fencing_sha" "$acquired" "$expires"
                ;;
            status)
                [[ -f $FORK_DEPLOY_QUIESCE_MARKER ]]
                IFS=: read -r recorded_operation acquired expires <"$FORK_DEPLOY_QUIESCE_MARKER"
                [[ $recorded_operation == "$operation_id" ]]
                printf 'backup-quiesce=status-passed;operation_id=%s;fencing_token_sha256=%s;lease_expires_unix=%s\n' \
                    "$operation_id" "$fencing_sha" "$expires"
                ;;
            release)
                [[ -f $FORK_DEPLOY_QUIESCE_MARKER ]]
                IFS=: read -r recorded_operation acquired expires <"$FORK_DEPLOY_QUIESCE_MARKER"
                [[ $recorded_operation == "$operation_id" ]]
                [[ ${FORK_DEPLOY_FAIL_QUIESCE_RELEASE:-false} != true ]] || exit 1
                rm -f "$FORK_DEPLOY_QUIESCE_MARKER"
                printf 'backup-quiesce=released;operation_id=%s;fencing_token_sha256=%s;released_unix=%s\n' \
                    "$operation_id" "$fencing_sha" "$(date +%s)"
                ;;
            *) exit 2 ;;
        esac
        ;;
    gpg)
        if [[ $* == *'--list-secret-keys'* ]]; then
            exit 1
        elif [[ $* == *'--with-colons'* && $* == *'--fingerprint'* ]]; then
            printf 'pub:-:255:22:0123456789ABCDEF:0:0:::::e:::::ed25519:::0:\n'
            printf 'fpr:::::::::0123456789ABCDEF0123456789ABCDEF01234567:\n'
        elif [[ $* == *'--with-colons'* && $* == *'--list-keys'* ]]; then
            printf 'pub:-:255:22:0123456789ABCDEF:0:0:::::e:::::ed25519:::0:\n'
            printf 'fpr:::::::::0123456789ABCDEF0123456789ABCDEF01234567:\n'
        elif [[ $* == *'--encrypt'* ]]; then
            output=
            input=${*: -1}
            previous=
            for argument in "$@"; do
                if [[ $previous == --output ]]; then output=$argument; fi
                previous=$argument
            done
            printf 'fixture-openpgp\n' >"$output"
            cat "$input" >>"$output"
        elif [[ $* == *'--list-only'* && $* == *'--decrypt'* ]]; then
            printf '[GNUPG:] ENC_TO 0123456789ABCDEF 22 0\n'
            exit 2
        else
            exit 2
        fi
        ;;
    uname)
        if [[ ${1:-} == -s ]]; then printf 'Linux\n'; else printf 'x86_64\n'; fi
        ;;
    openssl)
        if [[ ${1:-} == pkeyutl ]]; then
            if [[ ${FORK_DEPLOY_USE_REAL_OPENSSL:-false} == true ]]; then
                "$FORK_DEPLOY_REAL_OPENSSL" "$@"
            else
                [[ ${FORK_DEPLOY_OPENSSL_VERIFY_FAIL:-false} != true ]]
            fi
        else
            "$FORK_DEPLOY_REAL_OPENSSL" "$@"
        fi
        ;;
    chown)
        ;;
    ssh-keygen)
        if [[ ${1:-} == -y ]]; then
            printf 'ssh-ed25519 fixture-public-key\n'
        else
            output=
            while (($#)); do
                if [[ $1 == -f ]]; then output=$2; shift 2; else shift; fi
            done
            printf 'fixture-private-key\n' >"$output"
            printf 'ssh-ed25519 fixture-public-key coolify\n' >"$output.pub"
        fi
        ;;
    sleep)
        ;;
    curl)
        output=
        while (($#)); do
            if [[ $1 == --output ]]; then output=$2; shift 2; else shift; fi
        done
        case $output in
            */docker-compose.yml) printf 'services: {}\n' >"$output" ;;
            */docker-compose.prod.yml) printf 'services: {}\n' >"$output" ;;
            */.env.production) printf 'DB_USERNAME=coolify\nDB_DATABASE=coolify\n%s' "${FORK_DEPLOY_ENV_EXTRA:-}" >"$output" ;;
            */release-assets.contract) printf 'release-assets-contract%s\n' "${FORK_DEPLOY_CONTRACT_EXTRA:-}" >"$output" ;;
            *) exit 2 ;;
        esac
        ;;
    docker)
        case ${1:-} in
            info)
                [[ ${FORK_DEPLOY_DOCKER_UNAVAILABLE:-false} != true ]]
                ;;
            compose)
                if [[ ${2:-} == version ]]; then
                    if [[ ${3:-} == --short ]]; then printf '%s\n' "${FORK_DEPLOY_COMPOSE_VERSION:-v2.24.4}"; fi
                    exit 0
                fi
                if [[ $* == *' up '* ]]; then
                    [[ ! -e ${FORK_DEPLOY_QUIESCE_MARKER:-/nonexistent} ]] || exit 1
                    [[ ${FORK_DEPLOY_FAIL_COMPOSE_UP:-false} != true ]] || exit 1
                    : >"$FORK_DEPLOY_RUNTIME_MARKER"
                    : >"${FORK_DEPLOY_DB_MARKER:-$FORK_DEPLOY_RUNTIME_MARKER}"
                    : >"${FORK_DEPLOY_REDIS_MARKER:-$FORK_DEPLOY_RUNTIME_MARKER}"
                fi
                if [[ $* == *' config'* && $* == *--quiet* \
                    && $* == *"${FORK_DEPLOY_ACTIVE_SOURCE:-/nonexistent}"* \
                    && ${FORK_DEPLOY_KILL_ON_ACTIVE_CONFIG:-false} == true ]]; then
                    kill -KILL "$PPID"
                    exit 137
                fi
                if [[ $* == *' config'* && $* == *--quiet* \
                    && $* == *"${FORK_DEPLOY_ACTIVE_SOURCE:-/nonexistent}"* \
                    && ${FORK_DEPLOY_FAIL_ACTIVATED_CONFIG:-false} == true ]]; then
                    exit 1
                fi
                if [[ $* == *'--format json'* ]]; then
                    printf '%s\n' '{"services":{"coolify":{"ports":[{"host_ip":"127.0.0.1","published":"8000","target":8080}]},"soketi":{"ports":[{"host_ip":"127.0.0.1","published":"6001","target":6001},{"host_ip":"127.0.0.1","published":"6002","target":6002}]}}}'
                elif [[ $* == *--images* ]]; then
                    printf '%s\n' \
                        'docker.iocloudhost.net/williamagh/coolify@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' \
                        'docker.iocloudhost.net/williamagh/coolify-realtime@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb' \
                        'docker.io/library/postgres@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc' \
                        'docker.io/library/redis@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd'
                elif [[ $* == *' config'* && $* != *--quiet* ]]; then
                    previous=
                    for argument in "$@"; do
                        if [[ $previous == --env-file ]]; then cat "$argument"; break; fi
                        previous=$argument
                    done
                fi
                exit 0
                ;;
            pull) exit 0 ;;
            image)
                if [[ $* == *Architecture* ]]; then printf 'amd64\n'; else printf 'linux\n'; fi
                ;;
            network) exit 0 ;;
            volume)
                if [[ ${2:-} == ls && ${3:-} == --format && -n ${FORK_DEPLOY_LEGACY_VOLUMES:-} ]]; then
                    printf '%s\n' "$FORK_DEPLOY_LEGACY_VOLUMES"
                fi
                exit 0
                ;;
            cp)
                if [[ ${2:-} == coolify-redis:* ]]; then
                    [[ ${FORK_DEPLOY_FAIL_REDIS_COPY:-false} != true ]] || exit 1
                    printf 'REDIS0011fixture-snapshot\n' >"$3"
                fi
                exit 0
                ;;
            inspect)
                inspected=${*: -1}
                case $inspected in
                    coolify|coolify-realtime)
                        [[ -e ${FORK_DEPLOY_RUNTIME_MARKER:-/nonexistent} ]] || exit 1
                        ;;
                    coolify-db) [[ -e ${FORK_DEPLOY_DB_MARKER:-${FORK_DEPLOY_RUNTIME_MARKER:-/nonexistent}} ]] || exit 1 ;;
                    coolify-redis) [[ -e ${FORK_DEPLOY_REDIS_MARKER:-${FORK_DEPLOY_RUNTIME_MARKER:-/nonexistent}} ]] || exit 1 ;;
                esac
                if [[ $* == *.Mounts* ]]; then
                    attachment_list=${FORK_DEPLOY_LEGACY_VOLUME_ATTACHMENTS:-${FORK_DEPLOY_LEGACY_VOLUMES:-}}
                    case $inspected in
                        coolify-db)
                            case $'\n'$attachment_list$'\n' in
                                *$'\ncoolify-db\n'*) printf 'coolify-db\n' ;;
                            esac
                            ;;
                        coolify-redis)
                            case $'\n'$attachment_list$'\n' in
                                *$'\ncoolify-redis\n'*) printf 'coolify-redis\n' ;;
                            esac
                            ;;
                    esac
                elif [[ $* == *NetworkSettings.Ports* ]]; then
                    if [[ ${FORK_DEPLOY_HOST_IP:-} == absent ]]; then exit 1; fi
                    host_ip=${FORK_DEPLOY_HOST_IP:-127.0.0.1}
                    case ${*: -1} in
                        coolify) printf '8080/tcp\t%s\t%s\n' "$host_ip" "${FORK_DEPLOY_APP_PORT:-8000}" ;;
                        coolify-realtime)
                            printf '6001/tcp\t%s\t%s\n' "$host_ip" "${FORK_DEPLOY_SOKETI_PORT:-6001}"
                            printf '6002/tcp\t%s\t6002\n' "$host_ip"
                            ;;
                        *)
                            if [[ ${FORK_DEPLOY_EXTRA_BINDING:-false} == true ]]; then printf '9999/tcp\t%s\t9999\n' "$host_ip"; fi
                            ;;
                    esac
                elif [[ $* == *State.Running* ]]; then
                    printf 'true\n'
                elif [[ $* == *Config.Image* ]]; then
                    case ${*: -1} in
                        coolify-realtime) printf 'docker.iocloudhost.net/williamagh/coolify-realtime@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\n' ;;
                        coolify-db) printf 'docker.io/library/postgres@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\n' ;;
                        coolify-redis) printf 'docker.io/library/redis@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd\n' ;;
                        *) printf 'docker.iocloudhost.net/williamagh/coolify@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n' ;;
                    esac
                else
                    printf 'healthy\n'
                fi
                ;;
            exec)
                if [[ $* == *' pg_dump '* ]]; then
                    [[ -e ${FORK_DEPLOY_QUIESCE_MARKER:-/nonexistent} ]] || exit 1
                    [[ ${FORK_DEPLOY_FAIL_PG_DUMP:-false} != true ]] || exit 1
                    printf 'PGDMP fixture archive\n'
                elif [[ $* == *' pg_restore --list'* ]]; then
                    [[ ${FORK_DEPLOY_FAIL_PG_RESTORE_CHECK:-false} != true ]]
                elif [[ $* == *'redis-check-rdb'* ]]; then
                    [[ ${FORK_DEPLOY_FAIL_REDIS_CHECK:-false} != true ]]
                elif [[ $* == *'redis-cli'* && $* == *' SAVE'* ]]; then
                    [[ -e ${FORK_DEPLOY_QUIESCE_MARKER:-/nonexistent} ]] || exit 1
                    [[ ${FORK_DEPLOY_FAIL_REDIS_SAVE:-false} != true ]] || exit 1
                    printf 'OK\n'
                elif [[ $* == *'redis-cli'* && $* == *' CONFIG GET dir'* ]]; then
                    printf 'dir\n/data\n'
                elif [[ $* == *'redis-cli'* && $* == *' CONFIG GET dbfilename'* ]]; then
                    printf 'dbfilename\ndump.rdb\n'
                elif [[ $* == *'test -f'* || $* == *' rm -f '* ]]; then
                    exit 0
                elif [[ $* == *to_regclass* ]]; then
                    if [[ -n ${FORK_DEPLOY_MIGRATION_FINGERPRINT:-} ]]; then printf 'migrations\n'; else printf '\n'; fi
                else
                    printf '%s\n' "${FORK_DEPLOY_MIGRATION_FINGERPRINT:-d41d8cd98f00b204e9800998ecf8427e}"
                fi
                ;;
            ps) printf 'coolify Up healthy\n';;
        esac
        ;;
esac
