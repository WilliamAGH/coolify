readonly BACKUP_MAX_AGE_SECONDS=900
readonly BACKUP_QUIESCE_LEASE_SECONDS=1800
readonly BACKUP_RETENTION_COUNT=5
readonly PRODUCTION_QUIESCE_OPERATOR=/usr/local/sbin/control-plane-blue-green
REGISTRY=docker.iocloudhost.net
MAIN_REPOSITORY=$REGISTRY/williamagh/coolify
REALTIME_REPOSITORY=$REGISTRY/williamagh/coolify-realtime
POSTGRES_REPOSITORY=docker.io/library/postgres
REDIS_REPOSITORY=docker.io/library/redis
