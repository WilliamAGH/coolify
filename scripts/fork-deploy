PROGRAM=$(basename "$0")
TEST_MODE=${FORK_DEPLOY_TEST_MODE:-false}
ROOT=
SOURCE_DIR=
STATE_DIR=
RELEASES_DIR=
ACTIVATIONS_DIR=
BACKUPS_DIR=
CURRENT_FILE=
