QUIESCE_FENCING_TOKEN_SHA256=
QUIESCE_ACQUIRED_UNIX=
QUIESCE_RELEASED_UNIX=
QUIESCE_ACTIVE=false
RECOVERY_RECIPIENT_FINGERPRINT=
BACKUP_IN_PROGRESS_DIRECTORY=
BACKUP_ATTESTED=false
UNMANAGED_LAYOUT_SNAPSHOT_TAKEN=false
UNMANAGED_CANONICAL_LAYOUT_COMPLETE=false
UNMANAGED_SOURCE_ASSETS_PRESENT=false
UNMANAGED_SOURCE_ASSETS_ADOPTABLE=true
UNMANAGED_LEGACY_VOLUMES_PRESENT=false
UNMANAGED_LEGACY_VOLUMES_ADOPTABLE=true

test_mode() {
    [[ $TEST_MODE == true ]]
}

validate_absolute_path() {
    local path=$1 label=$2 component
    local -a components
    local IFS=/

    [[ $path == /* && $path != / ]] || die "$label must be an absolute non-root path"
    [[ $path != *$'\n'* && $path != *$'\r'* && $path != *'//' && ${path: -1} != / ]] || die "$label contains an unsafe path component"
    read -r -a components <<<"${path#/}"
    for component in "${components[@]}"; do
        [[ -n $component && $component != . && $component != .. ]] || die "$label contains an unsafe path component"
    done
}

assert_no_symlink_ancestors() {
    local path=$1 label=$2 component current=
    local -a components
    local IFS=/

    validate_absolute_path "$path" "$label"
    read -r -a components <<<"${path#/}"
    for component in "${components[@]}"; do
        current=$current/$component
        [[ ! -L $current ]] || die "$label contains a symbolic link: $current"
        if [[ $current != "$path" && -e $current && ! -d $current ]]; then
            die "$label has a non-directory ancestor: $current"
        fi
    done
}

require_regular_file() {
    local path=$1 label=$2

    assert_no_symlink_ancestors "$path" "$label"
    [[ -f $path && ! -L $path ]] || die "$label must be a regular non-symlink file: $path"
    [[ $(file_link_count "$path") == 1 ]] || die "$label must not be hardlinked: $path"
}

file_link_count() {
    local path=$1 count

    if count=$(stat -c '%h' "$path" 2>/dev/null); then
        :
    else
        count=$(stat -f '%l' "$path" 2>/dev/null) || die "could not inspect file link count: $path"
    fi
    [[ $count =~ ^[1-9][0-9]*$ ]] || die "invalid file link count: $path"
    printf '%s\n' "$count"
}

file_mode() {
    local path=$1 mode

    if mode=$(stat -c '%a' "$path" 2>/dev/null); then
        :
    else
        mode=$(stat -f '%Lp' "$path" 2>/dev/null) || die "could not inspect file mode: $path"
    fi
    printf '%s\n' "$mode"
}

file_owner() {
    local path=$1 owner

    if owner=$(stat -c '%u:%g' "$path" 2>/dev/null); then
        :
    else
        owner=$(stat -f '%u:%g' "$path" 2>/dev/null) || die "could not inspect file owner: $path"
    fi
    printf '%s\n' "$owner"
}

require_directory_or_missing() {
    local path=$1 label=$2

    assert_no_symlink_ancestors "$path" "$label"
    if [[ -e $path ]]; then
        [[ -d $path && ! -L $path ]] || die "$label must be a directory: $path"
    fi
}

configure_paths() {
    case $TEST_MODE in
        true|false) ;;
        *) die 'FORK_DEPLOY_TEST_MODE must be exactly true when test-only paths are enabled' ;;
    esac
    if test_mode; then
        ROOT=${COOLIFY_ROOT:-}
        AUTHORIZED_KEYS=${COOLIFY_AUTHORIZED_KEYS:-}
        [[ -n $ROOT && -n $AUTHORIZED_KEYS ]] || die 'COOLIFY_ROOT and COOLIFY_AUTHORIZED_KEYS are required when FORK_DEPLOY_TEST_MODE=true'
    else
        [[ -z ${COOLIFY_ROOT:-} || $COOLIFY_ROOT == /data/coolify ]] || die 'production Coolify root must canonicalize exactly to /data/coolify'
        [[ -z ${COOLIFY_AUTHORIZED_KEYS:-} || $COOLIFY_AUTHORIZED_KEYS == /root/.ssh/authorized_keys ]] || die 'production authorized_keys path must be exactly /root/.ssh/authorized_keys'
        ROOT=/data/coolify
        AUTHORIZED_KEYS=/root/.ssh/authorized_keys
    fi
    assert_no_symlink_ancestors "$ROOT" 'Coolify root'
    SOURCE_DIR=$ROOT/source
    STATE_DIR=$ROOT/fork-deploy
    RELEASES_DIR=$STATE_DIR/releases
    ACTIVATIONS_DIR=$STATE_DIR/activations
    BACKUPS_DIR=$STATE_DIR/backups
    CURRENT_FILE=$STATE_DIR/current
    HISTORY_FILE=$STATE_DIR/history.tsv
    LOCK_FILE=$STATE_DIR/deploy.lock
    PENDING_FILE=$STATE_DIR/pending-candidate
    FAILED_RESTORE_FILE=$STATE_DIR/failed-needs-restore
    QUIESCE_RECOVERY_FILE=$STATE_DIR/quiesce-release-failed
    if [[ $ACTION != recover-quiesce ]]; then
        validate_authorized_keys_path
    fi
}

usage() {
    cat <<'EOF'
Usage:
  fork-deploy install|update (--manifest HTTPS_URL | --offline-manifest ABSOLUTE_PATH) [--dry-run]
  fork-deploy rollback --version VERSION [--dry-run]
  fork-deploy repair [--dry-run]
  fork-deploy recover-abort
  fork-deploy recover-forward
  fork-deploy recover-quiesce
  fork-deploy status
  fork-deploy verify
  fork-deploy trust --public-key ABSOLUTE_PATH

Install and update inputs are accepted only from a detached-signature-verified release manifest.
In production the manifest signature must verify against
/etc/coolify-fork/release-signing-ed25519.pub.
Offline manifests provide only the signed manifest and detached signature; release assets still
require HTTPS unless restoring a previously recorded verified release.
The production-only trust action installs the built-in expected Ed25519 public key locally.
Rollback targets must be releases previously verified and recorded by this tool.
Recover-abort is allowed only for a durable pending state that proves the candidate never started.
Recover-forward retries the exact signed candidate after startup was declared and preserves all
writes accepted by that candidate. Snapshot restore is forbidden after candidate startup.
Recover-quiesce retries an attested backup-quiesce release that could not be confirmed during
backup cleanup. No deploy action is allowed while that writer fence is unresolved.
EOF
}

die() {
    printf 'ERROR: %s\n' "$*" >&2
    if [[ $RECOVERY_ARMED == true && $RECOVERY_HANDLED == false ]]; then
        deployment_failure 1
    fi
    exit 1
}

note() {
    printf '%s\n' "$*"
}

run() {
    if "$DRY_RUN"; then
        printf 'PLAN:'
        printf ' %q' "$@"
        printf '\n'
        return 0
    fi
    "$@"
}

validate_version() {
    [[ $1 =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)-fork(\.[1-9][0-9]*)?$ ]] \
        || die "invalid fork release version: $1"
}

fd_numeric_compare() {
    local left=$1 right=$2

    if ((${#left} < ${#right})); then
        printf '%s\n' -1
    elif ((${#left} > ${#right})); then
        printf '%s\n' 1
    elif [[ $left < $right ]]; then
        printf '%s\n' -1
    elif [[ $left > $right ]]; then
        printf '%s\n' 1
    else
        printf '%s\n' 0
    fi
}

fd_version_compare() {
    local left=$1 right=$2 left_suffix right_suffix comparison index
    local -a left_parts right_parts

    validate_version "$left"
    validate_version "$right"
    [[ $left =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)-fork(\.([1-9][0-9]*))?$ ]]
    left_parts=("${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}")
    left_suffix=${BASH_REMATCH[5]:-}
    [[ $right =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)-fork(\.([1-9][0-9]*))?$ ]]
    right_parts=("${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}")
    right_suffix=${BASH_REMATCH[5]:-}
    for index in 0 1 2; do
        comparison=$(fd_numeric_compare "${left_parts[index]}" "${right_parts[index]}")
        [[ $comparison == 0 ]] || {
            printf '%s\n' "$comparison"
            return 0
        }
    done
    if [[ -z $left_suffix && -n $right_suffix ]]; then
        printf '%s\n' -1
    elif [[ -n $left_suffix && -z $right_suffix ]]; then
        printf '%s\n' 1
    elif [[ -z $left_suffix ]]; then
        printf '%s\n' 0
    else
        fd_numeric_compare "$left_suffix" "$right_suffix"
    fi
}

validate_digest() {
    [[ $1 =~ ^sha256:[0-9a-f]{64}$ ]] || die "invalid sha256 digest: $1"
}

validate_revision() {
    [[ $1 =~ ^[0-9a-f]{40}$ ]] || die "source revision must be a full 40-character lowercase Git SHA"
}

validate_positive_integer() {
    [[ $1 =~ ^[1-9][0-9]*$ ]] || die "COOLIFY_HEALTH_ATTEMPTS must be a positive integer"
}

validate_port() {
    local port=$1 name=$2

    if [[ ! $port =~ ^[1-9][0-9]{0,4}$ ]] || ((10#$port > 65535)); then
        die "$name must be an integer from 1 through 65535"
    fi
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

host_platform() {
    local machine
    machine=$(uname -m)
    case $machine in
        x86_64) printf 'linux/amd64\n' ;;
        aarch64|arm64) printf 'linux/arm64\n' ;;
        *) die "unsupported host architecture: $machine" ;;
    esac
}

preflight() {
    local raw_version version major minor patch

    validate_authorized_keys_path
    [[ $(uname -s) == Linux ]] || die 'Coolify deployment requires Linux'
    if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
        if [[ $TEST_MODE != true || ${COOLIFY_ALLOW_NON_ROOT:-false} != true ]]; then
            die 'run as root (or set COOLIFY_ALLOW_NON_ROOT=true only with FORK_DEPLOY_TEST_MODE=true)'
        fi
    fi
    for command in docker curl sha256sum flock awk grep openssl ssh-keygen mktemp stat find tar \
        sed date sort wc tr; do
        require_command "$command"
    done
    docker info >/dev/null 2>&1 || die 'Docker daemon is unavailable'
    raw_version=$(docker compose version --short 2>/dev/null) || die 'Docker Compose v2 is unavailable'
    version=${raw_version#v}
    [[ $version =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]] || die "could not parse Docker Compose version: $raw_version"
    major=${BASH_REMATCH[1]}
    minor=${BASH_REMATCH[2]}
    patch=${BASH_REMATCH[3]}
    if ((10#$major < 2 || (10#$major == 2 && 10#$minor < 24) || (10#$major == 2 && 10#$minor == 24 && 10#$patch < 4))); then
        die "Docker Compose 2.24.4 or later is required for !override; found $raw_version"
    fi
    host_platform >/dev/null
}

recover_quiesce_preflight() {
    [[ $(uname -s) == Linux ]] || die 'Coolify deployment requires Linux'
    if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
        if [[ $TEST_MODE != true || ${COOLIFY_ALLOW_NON_ROOT:-false} != true ]]; then
            die 'run as root (or set COOLIFY_ALLOW_NON_ROOT=true only with FORK_DEPLOY_TEST_MODE=true)'
        fi
    fi
    for command in awk find flock grep sha256sum stat; do
        require_command "$command"
    done
}

validate_authorized_keys_path() {
    if ! test_mode; then
        [[ $AUTHORIZED_KEYS == /root/.ssh/authorized_keys ]] || die 'production authorized_keys path must be exactly /root/.ssh/authorized_keys'
    fi
    assert_no_symlink_ancestors "$AUTHORIZED_KEYS" 'authorized_keys path'
    if [[ -e $AUTHORIZED_KEYS ]]; then
        require_regular_file "$AUTHORIZED_KEYS" 'authorized_keys file'
    fi
}

ensure_secure_directory() {
    local path=$1 label=$2

    require_directory_or_missing "$path" "$label"
    if [[ ! -e $path ]]; then
        mkdir -p "$path"
    fi
    require_directory_or_missing "$path" "$label"
    chmod 0700 "$path"
}

ensure_state_layout() {
    ensure_secure_directory "$ROOT" 'Coolify root'
    chown root:root "$ROOT"
    chmod 0711 "$ROOT"
    ensure_secure_directory "$STATE_DIR" 'fork-deploy state directory'
    chown root:root "$STATE_DIR"
    ensure_secure_directory "$RELEASES_DIR" 'fork-deploy releases directory'
    ensure_secure_directory "$ACTIVATIONS_DIR" 'fork-deploy activations directory'
    ensure_secure_directory "$BACKUPS_DIR" 'fork-deploy backups directory'
}

state_file_safe_or_missing() {
    local path=$1 label=$2

    assert_no_symlink_ancestors "$path" "$label"
    if [[ -e $path || -L $path ]]; then
        require_regular_file "$path" "$label"
    fi
}

acquire_lock() {
    if "$DRY_RUN"; then
        return 0
    fi
    ensure_state_layout
    state_file_safe_or_missing "$LOCK_FILE" 'deployment lock'
    if [[ ! -e $LOCK_FILE && ! -L $LOCK_FILE ]]; then
        (
            umask 077
            set -C
            : >"$LOCK_FILE"
        ) 2>/dev/null || true
    fi
    require_regular_file "$LOCK_FILE" 'deployment lock'
    chmod 0600 "$LOCK_FILE"
    exec 9>>"$LOCK_FILE"
    flock -n 9 || die 'another fork-deploy operation is already running'
}

image_ref_main() { printf '%s@%s\n' "$MAIN_REPOSITORY" "$MAIN_DIGEST"; }
image_ref_realtime() { printf '%s@%s\n' "$REALTIME_REPOSITORY" "$REALTIME_DIGEST"; }
image_ref_postgres() { printf '%s@%s\n' "$POSTGRES_REPOSITORY" "$POSTGRES_DIGEST"; }
image_ref_redis() { printf '%s@%s\n' "$REDIS_REPOSITORY" "$REDIS_DIGEST"; }

validate_image_for_host() {
    local ref=$1 expected_platform=$2 actual_os actual_arch actual_platform
    run docker pull "$ref"
    if "$DRY_RUN"; then return 0; fi
    actual_os=$(docker image inspect --format '{{.Os}}' "$ref")
    actual_arch=$(docker image inspect --format '{{.Architecture}}' "$ref")
    actual_platform=$actual_os/$actual_arch
    [[ $actual_platform == "$expected_platform" ]] || die "image $ref is $actual_platform, expected $expected_platform"
}

download_asset() {
    local name=$1 destination=$2 url
    url=$GITHUB_RAW_BASE/$SOURCE_REVISION/$name
    run curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 "$url" --output "$destination"
}

write_overlay() {
    local path=$1 main_ref realtime_ref
    main_ref=$(image_ref_main)
    realtime_ref=$(image_ref_realtime)
    if "$DRY_RUN"; then
        note "PLAN: write immutable image overlay $path"
        return 0
    fi
    {
        printf 'services:\n'
        printf '  coolify:\n'
        printf '    image: "%s"\n' "$main_ref"
        printf '    ports: !override\n'
        printf '%s\n' "      - \"127.0.0.1:\${APP_PORT:-8000}:8080\""
        printf '    environment:\n'
        printf '      AUTOUPDATE: "false"\n'
        printf '  soketi:\n'
        printf '    image: "%s"\n' "$realtime_ref"
        printf '    ports: !override\n'
        printf '%s\n' "      - \"127.0.0.1:\${SOKETI_PORT:-6001}:6001\""
        printf '      - "127.0.0.1:6002:6002"\n'
        printf '  postgres:\n'
        printf '    image: "%s"\n' "$(image_ref_postgres)"
        printf '  redis:\n'
        printf '    image: "%s"\n' "$(image_ref_redis)"
    } >"$path"
    chmod 600 "$path"
}

set_env_value() {
    local file=$1 key=$2 value=$3 temporary
    temporary=$file.tmp.$$
    awk -F= -v key="$key" -v value="$value" '
        BEGIN { written=0 }
        $1 == key { if (!written) print key "=" value; written=1; next }
        { print }
        END { if (!written) print key "=" value }
    ' "$file" >"$temporary"
    chmod --reference="$file" "$temporary" 2>/dev/null || chmod 600 "$temporary"
    mv "$temporary" "$file"
}

env_value() {
    local file=$1 key=$2 value

    require_regular_file "$file" 'environment file'
    value=$(awk -F= -v wanted="$key" '
        $1 == wanted {
            count++
            value = substr($0, index($0, "=") + 1)
        }
        END {
            if (count != 1) {
                exit 1
            }
            print value
        }
    ' "$file") || die "environment field is missing or duplicated: $key"
    printf '%s\n' "$value"
}

optional_env_value() {
    local file=$1 key=$2 value

    require_regular_file "$file" 'environment file'
    value=$(awk -F= -v wanted="$key" '
        $1 == wanted {
            count++
            value = substr($0, index($0, "=") + 1)
        }
        END {
            if (count > 1) {
                exit 1
            }
            if (count == 1) {
                print value
            }
        }
    ' "$file") || die "environment field is duplicated: $key"
    printf '%s\n' "$value"
}

read_field() {
    local file=$1 key=$2 label=$3 value

    [[ $key =~ ^[A-Z0-9_]+$ ]] || die "invalid field name for $label: $key"
    require_regular_file "$file" "$label"
    value=$(awk -F= -v wanted="$key" '
        $1 == wanted {
            count++
            value = substr($0, index($0, "=") + 1)
        }
        END {
            if (count != 1) {
                exit 1
            }
            print value
        }
    ' "$file") || die "$label field is missing or duplicated: $key"
    printf '%s\n' "$value"
}

bootstrap_directories() {
    local directory

    if "$DRY_RUN"; then
        note "PLAN: securely create and validate Coolify data directories below $ROOT"
        return 0
    fi
    for directory in \
        "$ROOT" "$SOURCE_DIR" "$ROOT/ssh" "$ROOT/ssh/keys" "$ROOT/ssh/mux" \
        "$ROOT/applications" "$ROOT/databases" "$ROOT/backups" "$ROOT/services" \
        "$ROOT/proxy" "$ROOT/proxy/dynamic" "$ROOT/sentinel"; do
        require_directory_or_missing "$directory" 'Coolify data directory'
        if [[ ! -e $directory ]]; then
            mkdir "$directory"
        fi
        require_directory_or_missing "$directory" 'Coolify data directory'
    done
}

fd_assert_tree_safe_for_privileged_mutation() {
    local path=$1 label=$2 discovered

    require_directory_or_missing "$path" "$label"
    [[ -d $path ]] || return 0
    discovered=$(find "$path" -xdev -type l -print -quit)
    [[ -z $discovered ]] || die "$label contains a symbolic link: $discovered"
    discovered=$(find "$path" -xdev -type f -links +1 -print -quit)
    [[ -z $discovered ]] || die "$label contains a hardlinked file: $discovered"
}

enforce_data_permissions() {
    local directory
    if "$DRY_RUN"; then note "PLAN: enforce 9999:root ownership and 0700 modes below $ROOT"; return 0; fi
    chown root:root "$ROOT"
    chmod 0711 "$ROOT"
    for directory in source ssh applications databases backups services proxy sentinel; do
        [[ -e $ROOT/$directory ]] || continue
        fd_assert_tree_safe_for_privileged_mutation "$ROOT/$directory" "Coolify $directory tree"
        chown -R 9999:root "$ROOT/$directory"
        chmod -R 0700 "$ROOT/$directory"
        fd_assert_tree_safe_for_privileged_mutation "$ROOT/$directory" "Coolify $directory tree"
    done
}

adopt_localhost_ssh_key() {
    local private_key=$ROOT/ssh/keys/id.root@host.docker.internal public_key authorized_directory
    authorized_directory=${AUTHORIZED_KEYS%/*}
    validate_authorized_keys_path
    if "$DRY_RUN"; then note "PLAN: create or adopt localhost SSH identity $private_key without rotating it"; return 0; fi
    ensure_secure_directory "$ROOT/ssh" 'localhost SSH directory'
    ensure_secure_directory "$ROOT/ssh/keys" 'localhost SSH key directory'
    require_directory_or_missing "$authorized_directory" 'authorized_keys directory'
    if [[ ! -e $authorized_directory ]]; then
        mkdir -p "$authorized_directory"
    fi
    require_directory_or_missing "$authorized_directory" 'authorized_keys directory'
    chmod 0700 "$authorized_directory"
    assert_no_symlink_ancestors "$AUTHORIZED_KEYS" 'authorized_keys path'
    touch "$AUTHORIZED_KEYS"
    require_regular_file "$AUTHORIZED_KEYS" 'authorized_keys file'
    chmod 0600 "$AUTHORIZED_KEYS"
    assert_no_symlink_ancestors "$private_key" 'localhost Coolify SSH private key'
    if [[ ! -e $private_key ]]; then
        ssh-keygen -t ed25519 -a 100 -f "$private_key" -q -N '' -C coolify
    fi
    require_regular_file "$private_key" 'localhost Coolify SSH private key'
    public_key=$(ssh-keygen -y -f "$private_key") || die 'could not derive the localhost Coolify public key'
    [[ -n $public_key ]] || die 'localhost Coolify public key is empty'
    if ! awk -v key="$public_key" '($1 " " $2) == key {found=1} END {exit !found}' "$AUTHORIZED_KEYS"; then
        printf '%s coolify\n' "$public_key" >>"$AUTHORIZED_KEYS"
    fi
    chown 9999:root "$private_key"
    chmod 0600 "$private_key"
}

wait_for_health() {
    local attempt container status
    for ((attempt = 1; attempt <= HEALTH_ATTEMPTS; attempt++)); do
        for container in coolify coolify-db coolify-redis coolify-realtime; do
            status=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$container" 2>/dev/null || true)
            [[ $status == healthy || $status == running ]] || break
        done
        if [[ $container == coolify-realtime && ( $status == healthy || $status == running ) ]]; then return 0; fi
        sleep 2
    done
    note "ERROR: containers did not become healthy after $HEALTH_ATTEMPTS checks" >&2
    return 1
}

fd_parse_args() {
    (($# > 0)) || {
        usage >&2
        exit 2
    }
    ACTION=$1
    shift
    case $ACTION in
        install|update|rollback|repair|recover-abort|recover-forward|recover-quiesce|status|trust|verify) ;;
        -h|--help)
            usage
            exit 0
            ;;
        *) die "unknown action: $ACTION" ;;
    esac
    while (($# > 0)); do
        case $1 in
            --manifest)
                (($# >= 2)) || die '--manifest requires an HTTPS URL'
                MANIFEST_INPUT=$2
                shift 2
                ;;
            --offline-manifest)
                (($# >= 2)) || die '--offline-manifest requires an absolute path'
                OFFLINE_MANIFEST=$2
                shift 2
                ;;
            --version)
                (($# >= 2)) || die '--version requires a value'
                VERSION=$2
                shift 2
                ;;
            --public-key)
                (($# >= 2)) || die '--public-key requires an absolute path'
                [[ -z $TRUST_PUBLIC_KEY ]] || die '--public-key may be supplied only once'
                TRUST_PUBLIC_KEY=$2
                shift 2
                ;;
            --dry-run|--plan)
                DRY_RUN=true
                shift
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            --main-digest|--realtime-digest|--postgres-digest|--redis-digest|--source-revision)
                die "$1 is not accepted: a signed release manifest is the only source of deploy inputs"
                ;;
            *) die "unknown argument: $1" ;;
        esac
    done
    if [[ $ACTION != trust ]]; then
        validate_positive_integer "$HEALTH_ATTEMPTS"
    fi
    case $ACTION in
        install|update)
            [[ -n $MANIFEST_INPUT || -n $OFFLINE_MANIFEST ]] || die "$ACTION requires --manifest or --offline-manifest"
            [[ -z $MANIFEST_INPUT || -z $OFFLINE_MANIFEST ]] || die 'use only one of --manifest and --offline-manifest'
            [[ -z $VERSION ]] || die 'deploy version must come from the signed release manifest'
            [[ -z $TRUST_PUBLIC_KEY ]] || die "$ACTION does not accept --public-key"
            ;;
        rollback)
            [[ -n $VERSION && -z $MANIFEST_INPUT && -z $OFFLINE_MANIFEST && -z $TRUST_PUBLIC_KEY ]] || die 'rollback requires only --version'
            validate_version "$VERSION"
            ;;
        repair)
            [[ -z $VERSION && -z $MANIFEST_INPUT && -z $OFFLINE_MANIFEST && -z $TRUST_PUBLIC_KEY ]] || die "$ACTION does not accept release arguments"
            ;;
        recover-abort|recover-forward|recover-quiesce|status|verify)
            [[ -z $VERSION && -z $MANIFEST_INPUT && -z $OFFLINE_MANIFEST && -z $TRUST_PUBLIC_KEY && $DRY_RUN == false ]] \
                || die "$ACTION does not accept release arguments or --dry-run"
            ;;
        trust)
            [[ -n $TRUST_PUBLIC_KEY && -z $VERSION && -z $MANIFEST_INPUT && -z $OFFLINE_MANIFEST && $DRY_RUN == false ]] || die 'trust requires only --public-key ABSOLUTE_PATH'
            ;;
    esac
}

fd_assert_production_trust_parent() {
    local path=$1 parent component current='' metadata owner mode
    local -a components
    local IFS=/

    test_mode && return 0
    parent=$(fd_parent "$path")
    assert_no_symlink_ancestors "$parent" 'production release signing key directory'
    require_directory_or_missing "$parent" 'production release signing key directory'
    [[ -d $parent ]] || die 'production release signing key directory is missing'
    read -r -a components <<<"${parent#/}"
    for component in "${components[@]}"; do
        current=$current/$component
        metadata=$(stat -c '%u:%a' "$current") || die "could not inspect release signing trust path: $current"
        owner=${metadata%%:*}
        mode=${metadata#*:}
        [[ $owner == 0 ]] || die "release signing trust path is not root-owned: $current"
        (( (8#$mode & 022) == 0 )) || die "release signing trust path is group- or world-writable: $current"
    done
}

fd_assert_production_trust_path() {
    local path=$1 metadata owner mode

    test_mode && return 0
    fd_assert_production_trust_parent "$path"
    assert_no_symlink_ancestors "$path" 'production release signing key'
    require_regular_file "$path" 'production release signing key'
    metadata=$(stat -c '%u:%a' "$path") || die "could not inspect release signing trust path: $path"
    owner=${metadata%%:*}
    mode=${metadata#*:}
    [[ $owner == 0 ]] || die 'production release signing key is not root-owned'
    [[ $mode == 644 ]] || die 'production release signing key must have mode 0644'
}

fd_manifest_key_id() {
    local key=$1 key_hash

    openssl pkey -pubin -in "$key" -text_pub -noout | grep -F 'ED25519 Public-Key' >/dev/null \
        || die 'release signing key must be an Ed25519 public key'
    key_hash=$(openssl pkey -pubin -in "$key" -pubout -outform DER | sha256sum | awk '{print $1}') \
        || die 'could not derive the release signing key identifier'
    [[ $key_hash =~ ^[0-9a-f]{64}$ ]] || die 'release signing key identifier is invalid'
    printf 'sha256:%s\n' "$key_hash"
}

fd_preflight_trust() {
    local uid

    case $TEST_MODE in
        false) ;;
        true) die 'trust is available only in production' ;;
        *) die 'FORK_DEPLOY_TEST_MODE must be exactly true when test-only paths are enabled' ;;
    esac
    [[ $(uname -s) == Linux ]] || die 'production trust bootstrap requires Linux'
    uid=$(command -p id -u) || die 'could not determine effective user ID'
    [[ $uid == 0 ]] || die 'run trust as root'
    for command in awk chmod chown cp grep mkdir mktemp mv openssl rm sha256sum stat; do
        require_command "$command"
    done
}

fd_install_production_trust_key() {
    local source=$1 path=$PRODUCTION_MANIFEST_PUBLIC_KEY parent temporary key_id

    test_mode && die 'trust is available only in production'
    validate_absolute_path "$source" 'release signing public key'
    require_regular_file "$source" 'release signing public key'
    parent=$(fd_parent "$path")
    assert_no_symlink_ancestors "$path" 'production release signing key'
    require_directory_or_missing "$parent" 'production release signing key directory'
    if [[ ! -e $parent ]]; then
        mkdir -p "$parent"
    fi
    fd_assert_production_trust_parent "$path"
    state_file_safe_or_missing "$path" 'production release signing key'
    temporary=$(mktemp "$parent/.release-signing-ed25519.pub.XXXXXX")
    chmod 0600 "$temporary"
    if ! cp "$source" "$temporary"; then
        rm -f "$temporary"
        die 'could not copy release signing public key'
    fi
    key_id=$(fd_manifest_key_id "$temporary")
    if [[ $key_id != "$PRODUCTION_MANIFEST_KEY_ID" ]]; then
        rm -f "$temporary"
        die "release signing public key does not match required KEY_ID $PRODUCTION_MANIFEST_KEY_ID"
    fi
    chown root:root "$temporary"
    chmod 0644 "$temporary"
    mv -f "$temporary" "$path"
    fd_assert_production_trust_path "$path"
    [[ $(fd_manifest_key_id "$path") == "$PRODUCTION_MANIFEST_KEY_ID" ]] || die 'installed release signing public key changed unexpectedly'
    note "Installed production release signing key at $path"
}

fd_configure_manifest_trust() {
    if test_mode; then
        MANIFEST_PUBLIC_KEY=${FORK_DEPLOY_MANIFEST_PUBLIC_KEY:-}
        [[ -n $MANIFEST_PUBLIC_KEY ]] || die 'FORK_DEPLOY_MANIFEST_PUBLIC_KEY is required in FORK_DEPLOY_TEST_MODE'
    else
        MANIFEST_PUBLIC_KEY=$PRODUCTION_MANIFEST_PUBLIC_KEY
    fi
    assert_no_symlink_ancestors "$MANIFEST_PUBLIC_KEY" 'release signing key'
    require_regular_file "$MANIFEST_PUBLIC_KEY" 'release signing key'
    fd_assert_production_trust_path "$MANIFEST_PUBLIC_KEY"
    MANIFEST_TRUST_KEY_ID=$(fd_manifest_key_id "$MANIFEST_PUBLIC_KEY")
    if ! test_mode; then
        [[ $MANIFEST_TRUST_KEY_ID == "$PRODUCTION_MANIFEST_KEY_ID" ]] || die 'production release signing key does not match the built-in trusted key'
    fi
}

fd_download_manifest() {
    local destination

    if [[ -n $OFFLINE_MANIFEST ]]; then
        validate_absolute_path "$OFFLINE_MANIFEST" 'offline release manifest'
        require_regular_file "$OFFLINE_MANIFEST" 'offline release manifest'
        require_regular_file "$OFFLINE_MANIFEST.sig" 'offline release manifest signature'
        if "$DRY_RUN"; then
            MANIFEST_PATH=$OFFLINE_MANIFEST
            MANIFEST_SIGNATURE=$OFFLINE_MANIFEST.sig
            return 0
        fi
        destination=$(mktemp "$STATE_DIR/manifest.XXXXXX")
        cp -p "$OFFLINE_MANIFEST" "$destination"
        cp -p "$OFFLINE_MANIFEST.sig" "$destination.sig"
        chmod 0600 "$destination" "$destination.sig"
        MANIFEST_PATH=$destination
        MANIFEST_SIGNATURE=$destination.sig
        return 0
    fi
    [[ $MANIFEST_INPUT == https://* && $MANIFEST_INPUT != *$'\n'* && $MANIFEST_INPUT != *$'\r'* && $MANIFEST_INPUT != *' '* ]] || die '--manifest must be an HTTPS URL'
    destination=$(mktemp "$STATE_DIR/manifest.XXXXXX")
    chmod 0600 "$destination"
    curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --tlsv1.2 "$MANIFEST_INPUT" --output "$destination"
    curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --tlsv1.2 "$MANIFEST_INPUT.sig" --output "$destination.sig"
    chmod 0600 "$destination.sig"
    MANIFEST_PATH=$destination
    MANIFEST_SIGNATURE=$destination.sig
}

fd_assign_manifest_field() {
    local key=$1 value=$2

    case $key in
        SCHEMA) [[ $value == coolify-fork-release/v1 ]] || die 'unsupported release manifest schema' ;;
        KEY_ID)
            MANIFEST_KEY_ID=$value
            [[ $MANIFEST_KEY_ID =~ ^sha256:[0-9a-f]{64}$ ]] || die 'invalid release manifest KEY_ID'
            [[ $MANIFEST_KEY_ID == "$MANIFEST_TRUST_KEY_ID" ]] || die 'release manifest KEY_ID does not match the trusted Ed25519 public key'
            ;;
        VERSION) VERSION=$value; validate_version "$VERSION" ;;
        SOURCE_REVISION) SOURCE_REVISION=$value; validate_revision "$SOURCE_REVISION" ;;
        SOURCE_TAG) SOURCE_TAG=$value; [[ $SOURCE_TAG =~ ^[A-Za-z0-9._/-]{1,128}$ ]] || die 'invalid release manifest SOURCE_TAG' ;;
        PLATFORM) [[ $value == "$(host_platform)" ]] || die "release manifest platform $value does not match host $(host_platform)" ;;
        MAIN_IMAGE) MAIN_IMAGE=$value; [[ $MAIN_IMAGE == "$MAIN_REPOSITORY" ]] || die 'release manifest MAIN_IMAGE is not the approved Coolify repository' ;;
        MAIN_INDEX_DIGEST) MAIN_INDEX_DIGEST=$value; validate_digest "$MAIN_INDEX_DIGEST" ;;
        MAIN_PLATFORM_DIGEST) MAIN_DIGEST=$value; validate_digest "$MAIN_DIGEST" ;;
        REALTIME_IMAGE) REALTIME_IMAGE=$value; [[ $REALTIME_IMAGE == "$REALTIME_REPOSITORY" ]] || die 'release manifest REALTIME_IMAGE is not the approved realtime repository' ;;
        REALTIME_INDEX_DIGEST) REALTIME_INDEX_DIGEST=$value; validate_digest "$REALTIME_INDEX_DIGEST" ;;
        REALTIME_PLATFORM_DIGEST) REALTIME_DIGEST=$value; validate_digest "$REALTIME_DIGEST" ;;
        POSTGRES_IMAGE) POSTGRES_IMAGE=$value; [[ $POSTGRES_IMAGE == "$POSTGRES_REPOSITORY" ]] || die 'release manifest POSTGRES_IMAGE is not the approved PostgreSQL repository' ;;
        POSTGRES_DIGEST) POSTGRES_DIGEST=$value; validate_digest "$POSTGRES_DIGEST" ;;
        POSTGRES_MAJOR) POSTGRES_MAJOR=$value; [[ $POSTGRES_MAJOR =~ ^[1-9][0-9]*$ ]] || die 'invalid release manifest POSTGRES_MAJOR' ;;
        REDIS_IMAGE) REDIS_IMAGE=$value; [[ $REDIS_IMAGE == "$REDIS_REPOSITORY" ]] || die 'release manifest REDIS_IMAGE is not the approved Redis repository' ;;
        REDIS_DIGEST) REDIS_DIGEST=$value; validate_digest "$REDIS_DIGEST" ;;
        REDIS_MAJOR) REDIS_MAJOR=$value; [[ $REDIS_MAJOR =~ ^[1-9][0-9]*$ ]] || die 'invalid release manifest REDIS_MAJOR' ;;
        *SHA256) [[ $value =~ ^[0-9a-f]{64}$ ]] || die "invalid release manifest hash: $key"; printf -v "$key" '%s' "$value" ;;
        *) die "unknown release manifest field: $key" ;;
    esac
}

fd_load_manifest() {
    local index=0 line key value
    local -a expected=(
        SCHEMA KEY_ID VERSION SOURCE_REVISION SOURCE_TAG PLATFORM
        MAIN_IMAGE MAIN_INDEX_DIGEST MAIN_PLATFORM_DIGEST
        REALTIME_IMAGE REALTIME_INDEX_DIGEST REALTIME_PLATFORM_DIGEST
        POSTGRES_IMAGE POSTGRES_DIGEST POSTGRES_MAJOR
        REDIS_IMAGE REDIS_DIGEST REDIS_MAJOR
        MAIN_OCI_LABELS_SHA256 REALTIME_OCI_LABELS_SHA256
        MAIN_SBOM_SHA256 REALTIME_SBOM_SHA256
        MAIN_PROVENANCE_SHA256 REALTIME_PROVENANCE_SHA256
        DOCKERFILE_MAIN_SHA256 DOCKERFILE_REALTIME_SHA256
        COMPOSE_SHA256 COMPOSE_PROD_SHA256 COMPOSE_OVERLAY_SHA256
        ENV_PRODUCTION_SHA256 RELEASE_ASSET_CONTRACT_SHA256
    )

    require_regular_file "$MANIFEST_PATH" 'release manifest'
    require_regular_file "$MANIFEST_SIGNATURE" 'release manifest signature'
    openssl pkeyutl -verify -pubin -inkey "$MANIFEST_PUBLIC_KEY" -rawin -in "$MANIFEST_PATH" -sigfile "$MANIFEST_SIGNATURE" >/dev/null 2>&1 || die 'release manifest signature verification failed'
    while IFS= read -r line || [[ -n $line ]]; do
        [[ $line == *=* && $line != =* && $line != *$'\r'* ]] || die 'release manifest contains an invalid line'
        key=${line%%=*}
        value=${line#*=}
        [[ $index -lt ${#expected[@]} && $key == "${expected[index]}" ]] || die "release manifest has an unexpected, duplicate, or out-of-order field: $key"
        fd_assign_manifest_field "$key" "$value"
        index=$((index + 1))
    done <"$MANIFEST_PATH"
    [[ $index -eq ${#expected[@]} ]] || die 'release manifest is incomplete'
    [[ $SOURCE_TAG == "$VERSION" ]] || die 'release manifest SOURCE_TAG must exactly match VERSION'
}

fd_parent() {
    printf '%s\n' "${1%/*}"
}

fd_atomic_write() {
    local path=$1 label=$2 parent base temporary
    shift 2

    parent=$(fd_parent "$path")
    require_directory_or_missing "$parent" "$label parent"
    [[ -d $parent ]] || die "$label parent is missing: $parent"
    state_file_safe_or_missing "$path" "$label"
    base=$(basename "$path")
    temporary=$(mktemp "$parent/.$base.XXXXXX")
    chmod 0600 "$temporary"
    printf '%s\n' "$@" >"$temporary"
    mv -f "$temporary" "$path"
    state_file_safe_or_missing "$path" "$label"
}

fd_atomic_copy() {
    local source=$1 destination=$2 label=$3 parent base temporary

    require_regular_file "$source" "$label source"
    parent=$(fd_parent "$destination")
    require_directory_or_missing "$parent" "$label destination parent"
    [[ -d $parent ]] || die "$label destination parent is missing: $parent"
    state_file_safe_or_missing "$destination" "$label destination"
    base=$(basename "$destination")
    temporary=$(mktemp "$parent/.$base.XXXXXX")
    cp -p "$source" "$temporary"
    chmod --reference="$source" "$temporary" 2>/dev/null || chmod 0600 "$temporary"
    mv -f "$temporary" "$destination"
    state_file_safe_or_missing "$destination" "$label destination"
}

fd_remove_file() {
    local path=$1 label=$2

    assert_no_symlink_ancestors "$path" "$label"
    if [[ -e $path || -L $path ]]; then
        [[ -f $path || -L $path ]] || die "$label must be a file when present: $path"
        rm -f "$path"
    fi
}

fd_release_dir() {
    validate_version "$1"
    printf '%s/%s\n' "$RELEASES_DIR" "$1"
}

fd_activation_file() {
    validate_version "$1"
    printf '%s/%s\n' "$ACTIVATIONS_DIR" "$1"
}

fd_verify_recorded_bundle() {
    local dir=$1 asset expected actual

    require_regular_file "$dir/release.manifest" 'recorded release manifest'
    require_regular_file "$dir/release.manifest.sig" 'recorded release manifest signature'
    openssl pkeyutl -verify -pubin -inkey "$MANIFEST_PUBLIC_KEY" -rawin -in "$dir/release.manifest" -sigfile "$dir/release.manifest.sig" >/dev/null 2>&1 || die 'recorded release manifest signature verification failed'
    MANIFEST_PATH=$dir/release.manifest
    MANIFEST_SIGNATURE=$dir/release.manifest.sig
    fd_load_manifest
    for asset in docker-compose.yml docker-compose.prod.yml docker-compose.custom.yml .env.production release-assets.contract; do
        case $asset in
            docker-compose.yml) expected=$COMPOSE_SHA256 ;;
            docker-compose.prod.yml) expected=$COMPOSE_PROD_SHA256 ;;
            docker-compose.custom.yml) expected=$COMPOSE_OVERLAY_SHA256 ;;
            .env.production) expected=$ENV_PRODUCTION_SHA256 ;;
            release-assets.contract) expected=$RELEASE_ASSET_CONTRACT_SHA256 ;;
        esac
        require_regular_file "$dir/$asset" "recorded release asset $asset"
        actual=$(sha256sum "$dir/$asset" | awk '{print $1}')
        [[ $actual == "$expected" ]] || die "recorded release asset hash mismatch: $asset"
    done
}

fd_load_recorded_release() {
    local requested=$1 dir

    dir=$(fd_release_dir "$requested")
    require_regular_file "$dir/verified" "release $requested verified marker"
    fd_verify_recorded_bundle "$dir"
    [[ $VERSION == "$requested" ]] || die 'recorded release manifest version does not match its directory'
}

fd_load_activation() {
    local version=$1 file

    file=$(fd_activation_file "$version")
    require_regular_file "$file" "activation state for $version"
    [[ $(read_field "$file" VERSION "activation state for $version") == "$version" ]] || die "activation state version does not match $version"
    read_field "$file" MIGRATION_FINGERPRINT_AFTER "activation state for $version" >/dev/null
    read_field "$file" RENDERED_COMPOSE_SHA256 "activation state for $version" >/dev/null
}

fd_activation_field() {
    read_field "$(fd_activation_file "$1")" "$2" "activation state for $1"
}

fd_current_version() {
    local value

    require_regular_file "$CURRENT_FILE" 'active release state'
    read -r value <"$CURRENT_FILE"
    validate_version "$value"
    printf '%s\n' "$value"
}

fd_write_activation() {
    local before=$1 after=$2 rendered=$3 now

    now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    fd_atomic_write "$(fd_activation_file "$VERSION")" "activation state for $VERSION" "VERSION=$VERSION" "ACTIVATED_AT=$now" "MIGRATION_FINGERPRINT_BEFORE=$before" "MIGRATION_FINGERPRINT_AFTER=$after" "RENDERED_COMPOSE_SHA256=$rendered"
    fd_atomic_write "$CURRENT_FILE" 'active release state' "$VERSION"
    fd_append_history "$now"$'\t'"$ACTION"$'\t'"$VERSION"$'\t'"$MAIN_DIGEST"$'\t'"$REALTIME_DIGEST"$'\t'"$before"$'\t'"$after"
}

fd_activation_history_exists() {
    local activated_at=$1 before=$2 after=$3

    state_file_safe_or_missing "$HISTORY_FILE" 'activation history'
    [[ -e $HISTORY_FILE ]] || return 1
    awk -F '\t' \
        -v activated_at="$activated_at" \
        -v version="$VERSION" \
        -v main_digest="$MAIN_DIGEST" \
        -v realtime_digest="$REALTIME_DIGEST" \
        -v before="$before" \
        -v after="$after" '
            $1 == activated_at && $2 == "recover-forward" \
                && $3 == version && $4 == main_digest \
                && $5 == realtime_digest && $6 == before && $7 == after { found = 1 }
            END { exit !found }
        ' "$HISTORY_FILE"
}

fd_reconcile_forward_activation() {
    local before=$1 after=$2 rendered=$3 activation activated_at current

    activation=$(fd_activation_file "$VERSION")
    if [[ -e $CURRENT_FILE || -L $CURRENT_FILE ]]; then
        current=$(fd_current_version)
        [[ $current == "$VERSION" ]] \
            || die "forward recovery found active release $current; expected candidate $VERSION"
        fd_load_activation "$VERSION"
        [[ $(fd_activation_field "$VERSION" MIGRATION_FINGERPRINT_BEFORE) == "$before" \
            && $(fd_activation_field "$VERSION" MIGRATION_FINGERPRINT_AFTER) == "$after" \
            && $(fd_activation_field "$VERSION" RENDERED_COMPOSE_SHA256) == "$rendered" ]] \
            || die 'existing candidate activation differs from the forward-recovery result'
        activated_at=$(read_field "$activation" ACTIVATED_AT "activation state for $VERSION")
        [[ $activated_at =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] \
            || die 'existing candidate activation timestamp is invalid'
    else
        activated_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
        fd_atomic_write "$activation" "activation state for $VERSION" \
            "VERSION=$VERSION" \
            "ACTIVATED_AT=$activated_at" \
            "MIGRATION_FINGERPRINT_BEFORE=$before" \
            "MIGRATION_FINGERPRINT_AFTER=$after" \
            "RENDERED_COMPOSE_SHA256=$rendered"
        fd_atomic_write "$CURRENT_FILE" 'active release state' "$VERSION"
    fi
    if ! fd_activation_history_exists "$activated_at" "$before" "$after"; then
        fd_append_history "$activated_at"$'\t'recover-forward$'\t'"$VERSION"$'\t'"$MAIN_DIGEST"$'\t'"$REALTIME_DIGEST"$'\t'"$before"$'\t'"$after"
    fi
}

fd_mark_pending() {
    fd_atomic_write "$PENDING_FILE" 'pending deployment state' \
        'STATE=pending-candidate' \
        "CANDIDATE_VERSION=$VERSION" \
        "PREVIOUS_VERSION=$PREVIOUS_CURRENT_VERSION" \
        "MIGRATION_FINGERPRINT_BEFORE=$DEPLOYMENT_MIGRATION_FINGERPRINT" \
        "CONFIGURATION_BACKUP=$DEPLOYMENT_BACKUP" \
        "BACKUP_ATTESTATION_SHA256=$DEPLOYMENT_BACKUP_ATTESTATION_SHA256" \
        "BACKUP_SOURCE_VERSION=$DEPLOYMENT_BACKUP_SOURCE_VERSION" \
        "PRESTART_UNDO_SHA256=$DEPLOYMENT_PRESTART_UNDO_SHA256" \
        'CANDIDATE_STARTED=false'
    fd_remove_file "$CURRENT_FILE" 'active release state'
}

fd_write_candidate_started_pending() {
    fd_atomic_write "$PENDING_FILE" 'pending deployment state' \
        'STATE=pending-candidate' \
        "CANDIDATE_VERSION=$VERSION" \
        "PREVIOUS_VERSION=$PREVIOUS_CURRENT_VERSION" \
        "MIGRATION_FINGERPRINT_BEFORE=$DEPLOYMENT_MIGRATION_FINGERPRINT" \
        "CONFIGURATION_BACKUP=$DEPLOYMENT_BACKUP" \
        "BACKUP_ATTESTATION_SHA256=$DEPLOYMENT_BACKUP_ATTESTATION_SHA256" \
        "BACKUP_SOURCE_VERSION=$DEPLOYMENT_BACKUP_SOURCE_VERSION" \
        "PRESTART_UNDO_SHA256=$DEPLOYMENT_PRESTART_UNDO_SHA256" \
        'CANDIDATE_STARTED=true'
}

fd_write_forward_failure_state() {
    fd_atomic_write "$FAILED_RESTORE_FILE" 'failed deployment recovery state' \
        'STATE=failed-needs-forward-recovery' \
        "CANDIDATE_VERSION=$VERSION" \
        "PREVIOUS_VERSION=$PREVIOUS_CURRENT_VERSION" \
        "MIGRATION_FINGERPRINT_BEFORE=$DEPLOYMENT_MIGRATION_FINGERPRINT" \
        "CONFIGURATION_BACKUP=$DEPLOYMENT_BACKUP" \
        "BACKUP_ATTESTATION_SHA256=$DEPLOYMENT_BACKUP_ATTESTATION_SHA256" \
        "BACKUP_SOURCE_VERSION=$DEPLOYMENT_BACKUP_SOURCE_VERSION" \
        "PRESTART_UNDO_SHA256=$DEPLOYMENT_PRESTART_UNDO_SHA256" \
        "RECOVERY=Run $PROGRAM recover-forward to retry this exact signed candidate without restoring the pre-start snapshot. Do not start the previous release automatically."
}

fd_mark_candidate_started() {
    CANDIDATE_STARTED=true
    # Publish the conservative forward-only disposition before changing the pending phase. Either
    # atomic file is sufficient for recover-forward to reconcile an interrupted transition.
    fd_write_forward_failure_state
    fd_write_candidate_started_pending
}

fd_ensure_no_unresolved() {
    local pending_state pending_started failed_state candidate active activation

    if [[ -e $QUIESCE_RECOVERY_FILE || -L $QUIESCE_RECOVERY_FILE ]]; then
        require_regular_file "$QUIESCE_RECOVERY_FILE" 'backup quiesce recovery state'
        die "backup quiesce release is unresolved; run $PROGRAM recover-quiesce before running $PROGRAM"
    fi
    if [[ -e $FAILED_RESTORE_FILE || -L $FAILED_RESTORE_FILE ]]; then
        require_regular_file "$FAILED_RESTORE_FILE" 'failed deployment recovery state'
        failed_state=$(read_field "$FAILED_RESTORE_FILE" STATE 'failed deployment recovery state')
        case $failed_state in
            failed-needs-forward-recovery)
                die "a candidate-started deployment requires forward recovery; run $PROGRAM recover-forward"
                ;;
            failed-needs-restore)
                if [[ -e $PENDING_FILE || -L $PENDING_FILE ]]; then
                    require_regular_file "$PENDING_FILE" 'pending deployment state'
                    pending_state=$(read_field "$PENDING_FILE" STATE 'pending deployment state')
                    pending_started=$(read_field "$PENDING_FILE" CANDIDATE_STARTED \
                        'pending deployment state')
                    if [[ $pending_state == pending-candidate && $pending_started == true ]]; then
                        die "a legacy candidate-started deployment forbids snapshot restore; run $PROGRAM recover-forward"
                    fi
                fi
                candidate=$(awk -F= '
                    $1 == "CANDIDATE_VERSION" { count++; value = substr($0, length($1) + 2) }
                    END { if (count == 1) print value }
                ' "$FAILED_RESTORE_FILE")
                if [[ -n $candidate ]]; then
                    validate_version "$candidate"
                    activation=$(fd_activation_file "$candidate")
                    if [[ ( -e $activation || -L $activation ) \
                        && ( -e $CURRENT_FILE || -L $CURRENT_FILE ) ]]; then
                        fd_load_activation "$candidate"
                        active=$(fd_current_version)
                        [[ $active == "$candidate" ]] \
                            || die 'legacy failed state conflicts with the active release; manual recovery is required'
                        die "a legacy candidate activation requires forward cleanup; run $PROGRAM recover-forward"
                    fi
                fi
                die 'legacy failed state does not prove a safe restore boundary; snapshot restore is forbidden and manual recovery is required'
                ;;
            *) die 'failed deployment recovery state is invalid' ;;
        esac
    fi
    if [[ -e $PENDING_FILE || -L $PENDING_FILE ]]; then
        require_regular_file "$PENDING_FILE" 'pending deployment state'
        pending_state=$(read_field "$PENDING_FILE" STATE 'pending deployment state')
        pending_started=$(read_field "$PENDING_FILE" CANDIDATE_STARTED 'pending deployment state')
        if [[ $pending_started == false && ( $pending_state == pending-candidate \
            || $pending_state == recover-abort-restoring || $pending_state == recover-abort-finalizing \
            || $pending_state == recover-abort-cleaning ) ]]; then
            die "a deployment is pending before candidate startup; run $PROGRAM recover-abort before running $PROGRAM"
        fi
        if [[ $pending_started == true && $pending_state == pending-candidate ]]; then
            die "a candidate-started deployment requires forward recovery; run $PROGRAM recover-forward"
        fi
        die "a deployment is pending or was interrupted; inspect $PENDING_FILE before running $PROGRAM"
    fi
}

fd_validate_ports() {
    local environment=$1 app_port soketi_port

    app_port=$(optional_env_value "$environment" APP_PORT)
    soketi_port=$(optional_env_value "$environment" SOKETI_PORT)
    app_port=${app_port:-8000}
    soketi_port=${soketi_port:-6001}
    validate_port "$app_port" APP_PORT
    validate_port "$soketi_port" SOKETI_PORT
    [[ $app_port != "$soketi_port" && $app_port != 6002 && $soketi_port != 6002 ]] || die 'APP_PORT, SOKETI_PORT, and the fixed Soketi metrics port 6002 must be distinct'
}

fd_normalize_staged_ports() {
    local environment=$1 app_port soketi_port

    app_port=$(optional_env_value "$environment" APP_PORT)
    soketi_port=$(optional_env_value "$environment" SOKETI_PORT)
    app_port=${app_port:-8000}
    soketi_port=${soketi_port:-6001}
    fd_validate_ports "$environment"
    set_env_value "$environment" APP_PORT "$app_port"
    set_env_value "$environment" SOKETI_PORT "$soketi_port"
}

fd_prepare_staged_environment() {
    local staging=$1 environment source entry key generator value

    environment=$staging/.env
    source=$SOURCE_DIR/.env

    require_regular_file "$staging/.env.production" 'staged .env.production'
    require_directory_or_missing "$SOURCE_DIR" 'Coolify source directory'
    if [[ -e $source || -L $source ]]; then
        require_regular_file "$source" 'existing .env'
        cp -p "$source" "$environment"
    else
        cp -p "$staging/.env.production" "$environment"
    fi
    chmod 0600 "$environment"
    for entry in APP_ID:hex16 APP_KEY:appkey DB_PASSWORD:base64 REDIS_PASSWORD:base64 PUSHER_APP_ID:hex32 PUSHER_APP_KEY:hex32 PUSHER_APP_SECRET:hex32; do
        key=${entry%%:*}
        generator=${entry#*:}
        if ! awk -F= -v key="$key" '$1 == key && length(substr($0, length($1) + 2)) > 0 { found=1 } END { exit !found }' "$environment"; then
            case $generator in
                hex16) value=$(openssl rand -hex 16) ;;
                hex32) value=$(openssl rand -hex 32) ;;
                base64) value=$(openssl rand -base64 32 | tr -d '\n') ;;
                appkey) value=base64:$(openssl rand -base64 32 | tr -d '\n') ;;
            esac
            set_env_value "$environment" "$key" "$value"
        fi
    done
    fd_normalize_staged_ports "$environment"
    set_env_value "$environment" AUTOUPDATE false
    set_env_value "$environment" COOLIFY_FORK_VERSION "$VERSION"
    set_env_value "$environment" VERSIONS_URL "$DISABLED_VERSIONS_URL"
    set_env_value "$environment" UPGRADE_SCRIPT_URL "$DISABLED_UPGRADE_SCRIPT_URL"
    set_env_value "$environment" RELEASES_URL "$DISABLED_RELEASES_URL"
}

fd_compose_in() {
    local directory=$1
    shift

    docker compose --env-file "$directory/.env" --file "$directory/docker-compose.yml" --file "$directory/docker-compose.prod.yml" --file "$directory/docker-compose.custom.yml" "$@"
}

fd_count() {
    local value=$1 needle=$2 count=0

    while [[ $value == *"$needle"* ]]; do
        value=${value#*"$needle"}
        count=$((count + 1))
    done
    printf '%s\n' "$count"
}

fd_validate_effective_images() {
    local directory=$1 images reference expected found count=0

    images=$(fd_compose_in "$directory" config --images) || die 'could not render effective Compose images'
    for reference in "$(image_ref_main)" "$(image_ref_realtime)" "$(image_ref_postgres)" "$(image_ref_redis)"; do
        found=false
        while IFS= read -r expected; do
            if [[ $expected == "$reference" ]]; then
                found=true
                break
            fi
        done <<<"$images"
        "$found" || die "effective Compose is missing immutable image $reference"
    done
    while IFS= read -r reference; do
        [[ -z $reference ]] || {
            [[ $reference =~ @sha256:[0-9a-f]{64}$ ]] || die "effective Compose contains mutable image reference: $reference"
            count=$((count + 1))
        }
    done <<<"$images"
    [[ $count -eq 4 ]] || die "effective Compose must contain exactly four immutable service images, found $count"
}

fd_validate_effective_bindings() {
    local directory=$1 json compact remainder host_ip count=0 target app_port soketi_port

    app_port=$(env_value "$directory/.env" APP_PORT)
    soketi_port=$(env_value "$directory/.env" SOKETI_PORT)
    validate_port "$app_port" APP_PORT
    validate_port "$soketi_port" SOKETI_PORT
    [[ $app_port != "$soketi_port" && $app_port != 6002 && $soketi_port != 6002 ]] || die 'APP_PORT, SOKETI_PORT, and the fixed Soketi metrics port 6002 must be distinct'
    json=$(fd_compose_in "$directory" config --format json) || die 'could not render effective Compose port bindings'
    compact=${json//[[:space:]]/}
    remainder=$compact
    while [[ $remainder == *'"host_ip":'* ]]; do
        remainder=${remainder#*'"host_ip":'}
        [[ $remainder == \"* ]] || die 'effective Compose has an invalid host_ip binding'
        remainder=${remainder#\"}
        host_ip=${remainder%%\"*}
        remainder=${remainder#*\"}
        [[ $host_ip == 127.0.0.1 ]] || die "effective Compose contains a non-loopback port binding: $host_ip"
        count=$((count + 1))
    done
    [[ $count -eq 3 ]] || die "effective Compose must contain exactly three loopback port bindings, found $count"
    for target in 8080 6001 6002; do
        [[ $(fd_count "$compact" "\"target\":$target") -eq 1 ]] || die "effective Compose must contain exactly one loopback target port $target"
    done
    [[ $(fd_count "$compact" '"published":') -eq 3 ]] || die 'effective Compose must contain exactly three published ports'
    for target in "$app_port" "$soketi_port" 6002; do
        [[ $compact == *"\"published\":\"$target\""* || $compact == *"\"published\":$target"* ]] || die "effective Compose is missing loopback host port $target"
    done
}

fd_validate_staging() {
    local staging=$1 asset

    for asset in docker-compose.yml docker-compose.prod.yml docker-compose.custom.yml .env.production .env release-assets.contract; do
        require_regular_file "$staging/$asset" "staged $asset"
    done
    fd_compose_in "$staging" config --quiet || die 'staged Compose configuration is invalid'
    fd_validate_effective_images "$staging"
    fd_validate_effective_bindings "$staging"
}

fd_assert_staged_hashes() {
    local staging=$1 asset expected actual

    for asset in docker-compose.yml docker-compose.prod.yml docker-compose.custom.yml .env.production release-assets.contract; do
        case $asset in
            docker-compose.yml) expected=$COMPOSE_SHA256 ;;
            docker-compose.prod.yml) expected=$COMPOSE_PROD_SHA256 ;;
            docker-compose.custom.yml) expected=$COMPOSE_OVERLAY_SHA256 ;;
            .env.production) expected=$ENV_PRODUCTION_SHA256 ;;
            release-assets.contract) expected=$RELEASE_ASSET_CONTRACT_SHA256 ;;
        esac
        actual=$(sha256sum "$staging/$asset" | awk '{print $1}')
        [[ $actual == "$expected" ]] || die "staged $asset does not match the signed release manifest"
    done
}

fd_new_staging() {
    local staging

    staging=$(mktemp -d "$STATE_DIR/staging.XXXXXX")
    chmod 0700 "$staging"
    assert_no_symlink_ancestors "$staging" 'staging directory'
    printf '%s\n' "$staging"
}

fd_stage_remote() {
    local staging=$1

    download_asset docker-compose.yml "$staging/docker-compose.yml"
    download_asset docker-compose.prod.yml "$staging/docker-compose.prod.yml"
    download_asset .env.production "$staging/.env.production"
    download_asset docker/control-plane-blue-green/release-assets.contract "$staging/release-assets.contract"
    write_overlay "$staging/docker-compose.custom.yml"
    fd_prepare_staged_environment "$staging"
    fd_assert_staged_hashes "$staging"
    fd_validate_staging "$staging"
}

fd_stage_recorded() {
    local staging=$1 dir asset

    dir=$(fd_release_dir "$VERSION")
    fd_verify_recorded_bundle "$dir"
    for asset in docker-compose.yml docker-compose.prod.yml docker-compose.custom.yml .env.production release-assets.contract; do
        cp -p "$dir/$asset" "$staging/$asset"
    done
    fd_prepare_staged_environment "$staging"
    fd_assert_staged_hashes "$staging"
    fd_validate_staging "$staging"
}

fd_append_history() {
    local line=$1 temporary

    state_file_safe_or_missing "$HISTORY_FILE" 'activation history'
    temporary=$(mktemp "$STATE_DIR/.history.XXXXXX")
    chmod 0600 "$temporary"
    if [[ -f $HISTORY_FILE ]]; then
        cp -p "$HISTORY_FILE" "$temporary"
    fi
    printf '%s\n' "$line" >>"$temporary"
    mv -f "$temporary" "$HISTORY_FILE"
    state_file_safe_or_missing "$HISTORY_FILE" 'activation history'
}

fd_migration_fingerprint() {
    local environment=$1 username database table_exists fingerprint

    if ! docker inspect coolify-db >/dev/null 2>&1; then
        printf 'uninitialized\n'
        return 0
    fi
    username=$(env_value "$environment" DB_USERNAME)
    database=$(env_value "$environment" DB_DATABASE)
    table_exists=$(docker exec coolify-db psql -U "$username" -d "$database" -Atc "SELECT COALESCE(to_regclass('public.migrations')::text, '');") || die 'could not inspect the Coolify migration table'
    if [[ $table_exists != migrations && $table_exists != public.migrations ]]; then
        printf 'uninitialized\n'
        return 0
    fi
    fingerprint=$(docker exec coolify-db psql -U "$username" -d "$database" -Atc "SELECT md5(COALESCE(string_agg(migration || ':' || batch::text, ',' ORDER BY migration), '')) FROM migrations;") || die 'could not fingerprint Coolify migrations'
    [[ $fingerprint =~ ^[0-9a-f]{32}$ ]] || die 'database returned an invalid migration fingerprint'
    printf '%s\n' "$fingerprint"
}

fd_container_exists() {
    docker inspect "$1" >/dev/null 2>&1
}

fd_container_running() {
    local running

    running=$(docker inspect --format '{{.State.Running}}' "$1" 2>/dev/null) || return 1
    [[ $running == true ]]
}

fd_control_plane_state_has_content() {
    local directory discovered

    for directory in applications backups databases proxy sentinel services ssh; do
        require_directory_or_missing "$ROOT/$directory" "legacy control-plane state $directory"
        [[ -d $ROOT/$directory ]] || continue
        discovered=$(find "$ROOT/$directory" -mindepth 1 ! -type d -print -quit)
        [[ -z $discovered ]] || return 0
    done
    return 1
}

fd_scan_unmanaged_source_assets() {
    local asset name

    UNMANAGED_SOURCE_ASSETS_PRESENT=false
    UNMANAGED_SOURCE_ASSETS_ADOPTABLE=true
    require_directory_or_missing "$SOURCE_DIR" 'unmanaged Coolify source directory'
    [[ -d $SOURCE_DIR ]] || return 0
    while IFS= read -r -d '' asset; do
        UNMANAGED_SOURCE_ASSETS_PRESENT=true
        name=${asset#"$SOURCE_DIR"/}
        case $name in
            .env|.env.production|docker-compose.yml|docker-compose.prod.yml|docker-compose.custom.yml)
                require_regular_file "$asset" "unmanaged Coolify source asset $name"
                ;;
            *) UNMANAGED_SOURCE_ASSETS_ADOPTABLE=false ;;
        esac
    done < <(find "$SOURCE_DIR" -mindepth 1 -maxdepth 1 -print0)
}

fd_container_uses_named_volume() {
    local container=$1 expected_volume=$2 mounts mount

    mounts=$(docker inspect --format '{{range .Mounts}}{{if eq .Type "volume"}}{{.Name}}{{"\\n"}}{{end}}{{end}}' "$container") \
        || return 1
    while IFS= read -r mount; do
        [[ $mount == "$expected_volume" ]] && return 0
    done <<<"$mounts"
    return 1
}

fd_scan_unmanaged_legacy_volumes() {
    local database_exists=$1 redis_exists=$2 volumes volume

    UNMANAGED_LEGACY_VOLUMES_PRESENT=false
    UNMANAGED_LEGACY_VOLUMES_ADOPTABLE=true
    volumes=$(docker volume ls --format '{{.Name}}') \
        || die 'could not list Docker volumes while classifying unmanaged Coolify state'
    while IFS= read -r volume; do
        [[ -n $volume ]] || continue
        case $volume in
            coolify-db)
                UNMANAGED_LEGACY_VOLUMES_PRESENT=true
                [[ $database_exists == true ]] \
                    && fd_container_uses_named_volume coolify-db "$volume" \
                    || UNMANAGED_LEGACY_VOLUMES_ADOPTABLE=false
                ;;
            coolify-redis)
                UNMANAGED_LEGACY_VOLUMES_PRESENT=true
                [[ $redis_exists == true ]] \
                    && fd_container_uses_named_volume coolify-redis "$volume" \
                    || UNMANAGED_LEGACY_VOLUMES_ADOPTABLE=false
                ;;
            coolify-db-pg[0-9]*)
                # A PostgreSQL-upgrade volume is not captured by this deployer. Never adopt it silently.
                UNMANAGED_LEGACY_VOLUMES_PRESENT=true
                UNMANAGED_LEGACY_VOLUMES_ADOPTABLE=false
                ;;
        esac
    done <<<"$volumes"
}

fd_snapshot_unmanaged_layout() {
    local directory

    UNMANAGED_LAYOUT_SNAPSHOT_TAKEN=true
    UNMANAGED_CANONICAL_LAYOUT_COMPLETE=true
    for directory in source applications backups databases proxy sentinel services ssh; do
        require_directory_or_missing "$ROOT/$directory" "pre-adoption Coolify $directory directory"
        [[ -d $ROOT/$directory ]] || UNMANAGED_CANONICAL_LAYOUT_COMPLETE=false
    done
}

fd_validate_legacy_environment() {
    local key value

    require_regular_file "$SOURCE_DIR/.env" 'legacy Coolify environment'
    for key in DB_USERNAME DB_DATABASE REDIS_PASSWORD; do
        value=$(env_value "$SOURCE_DIR/.env" "$key")
        [[ -n $value && $value != *$'\n'* && $value != *$'\r'* ]] \
            || die "legacy Coolify environment has an invalid $key"
    done
}

fd_classify_backup_requirement() {
    local container signal=false database_exists=false redis_exists=false
    local database_running=false redis_running=false environment_exists=false state_exists=false

    if [[ -n $PREVIOUS_CURRENT_VERSION ]]; then
        DEPLOYMENT_BACKUP_SOURCE_VERSION=$PREVIOUS_CURRENT_VERSION
        DEPLOYMENT_BACKUP_REQUIRE_COMPLETE=true
        return 0
    fi
    for container in coolify coolify-realtime coolify-db coolify-redis; do
        if fd_container_exists "$container"; then
            signal=true
            case $container in
                coolify-db) database_exists=true; fd_container_running "$container" && database_running=true ;;
                coolify-redis) redis_exists=true; fd_container_running "$container" && redis_running=true ;;
            esac
        fi
    done
    if [[ -e $SOURCE_DIR/.env || -L $SOURCE_DIR/.env ]]; then
        signal=true
        environment_exists=true
    fi
    fd_scan_unmanaged_source_assets
    if [[ $UNMANAGED_SOURCE_ASSETS_PRESENT == true ]]; then
        signal=true
    fi
    fd_scan_unmanaged_legacy_volumes "$database_exists" "$redis_exists"
    if [[ $UNMANAGED_LEGACY_VOLUMES_PRESENT == true ]]; then
        signal=true
    fi
    if fd_control_plane_state_has_content; then
        signal=true
        state_exists=true
    fi
    if [[ $signal == false ]]; then
        DEPLOYMENT_BACKUP_SOURCE_VERSION=unmanaged
        DEPLOYMENT_BACKUP_REQUIRE_COMPLETE=false
        return 0
    fi
    if [[ $database_exists == true && $redis_exists == true \
        && $database_running == true && $redis_running == true \
        && $environment_exists == true \
        && $UNMANAGED_LAYOUT_SNAPSHOT_TAKEN == true \
        && $UNMANAGED_CANONICAL_LAYOUT_COMPLETE == true \
        && $UNMANAGED_SOURCE_ASSETS_ADOPTABLE == true \
        && $UNMANAGED_LEGACY_VOLUMES_ADOPTABLE == true ]]; then
        fd_validate_legacy_environment
        DEPLOYMENT_BACKUP_SOURCE_VERSION=legacy-unmanaged
        DEPLOYMENT_BACKUP_REQUIRE_COMPLETE=true
        return 0
    fi
    die "unmanaged Coolify state is ambiguous; refusing adoption (database=$database_exists/$database_running redis=$redis_exists/$redis_running environment=$environment_exists source_assets=$UNMANAGED_SOURCE_ASSETS_PRESENT/$UNMANAGED_SOURCE_ASSETS_ADOPTABLE legacy_volumes=$UNMANAGED_LEGACY_VOLUMES_PRESENT/$UNMANAGED_LEGACY_VOLUMES_ADOPTABLE state=$state_exists canonical_layout=$UNMANAGED_CANONICAL_LAYOUT_COMPLETE)"
}

fd_configure_recovery_key() {
    local keyring=${GNUPGHOME:-} fingerprint=${CONTROL_PLANE_BACKUP_EXPECTED_RECIPIENT_FINGERPRINT:-}
    local listing primary capability

    require_command gpg
    validate_absolute_path "$keyring" 'backup recovery GNUPGHOME'
    require_directory_or_missing "$keyring" 'backup recovery GNUPGHOME'
    [[ -d $keyring && $(file_mode "$keyring") == 700 ]] \
        || die 'backup recovery GNUPGHOME must be a mode-0700 directory'
    if ! test_mode; then
        [[ $(file_owner "$keyring") == 0:0 ]] \
            || die 'backup recovery GNUPGHOME must be owned by root:root'
    fi
    [[ $fingerprint =~ ^[0-9A-F]{40}$ ]] \
        || die 'CONTROL_PLANE_BACKUP_EXPECTED_RECIPIENT_FINGERPRINT must be exactly 40 uppercase hexadecimal characters'
    listing=$(GNUPGHOME=$keyring gpg --batch --with-colons --fingerprint "$fingerprint" 2>/dev/null) \
        || die 'the exact backup recovery public key is unavailable'
    primary=$(awk -F: '$1 == "fpr" { print $10; exit }' <<<"$listing")
    capability=$(awk -F: '$1 == "pub" { print $12; exit }' <<<"$listing")
    [[ $primary == "$fingerprint" && $capability == *e* ]] \
        || die 'the backup recovery key fingerprint or encryption capability is invalid'
    if GNUPGHOME=$keyring gpg --batch --with-colons --list-secret-keys "$fingerprint" \
        >/dev/null 2>&1; then
        die 'the backup recovery private key must not exist on the deployment host'
    fi
    RECOVERY_RECIPIENT_FINGERPRINT=$fingerprint
}

fd_validate_encrypted_artifact() {
    local path=$1 expected_sha=$2 label=$3 status key_id listing primary

    fd_assert_private_backup_file "$path" "$label"
    [[ $(sha256sum "$path" | awk '{print $1}') == "$expected_sha" ]] \
        || die "$label hash differs from its attestation"
    status=$(GNUPGHOME=$GNUPGHOME gpg --batch --status-fd 1 --list-only --decrypt "$path" \
        2>/dev/null || true)
    key_id=$(awk '$1 == "[GNUPG:]" && $2 == "ENC_TO" { count++; value=$3 } END { if (count != 1) exit 1; print value }' \
        <<<"$status") || die "$label does not contain exactly one OpenPGP recipient packet"
    [[ $key_id =~ ^[0-9A-F]{16}$ ]] || die "$label contains an invalid OpenPGP recipient key ID"
    listing=$(GNUPGHOME=$GNUPGHOME gpg --batch --with-colons --list-keys "$key_id" 2>/dev/null) \
        || die "$label recipient key is unavailable"
    primary=$(awk -F: '$1 == "fpr" { print $10; exit }' <<<"$listing")
    [[ $primary == "$RECOVERY_RECIPIENT_FINGERPRINT" ]] \
        || die "$label is not encrypted to the configured recovery key"
}

fd_encrypt_artifact() {
    local plaintext=$1 ciphertext=$2 label=$3

    require_regular_file "$plaintext" "$label plaintext"
    GNUPGHOME=$GNUPGHOME gpg --batch --yes --quiet --trust-model always \
        --recipient "$RECOVERY_RECIPIENT_FINGERPRINT" \
        --output "$ciphertext" --encrypt "$plaintext" \
        || die "$label encryption failed"
    chmod 0600 "$ciphertext"
    fd_validate_encrypted_artifact "$ciphertext" \
        "$(sha256sum "$ciphertext" | awk '{print $1}')" "$label ciphertext"
    rm -f "$plaintext"
}

fd_configure_quiesce_operator() {
    if test_mode; then
        QUIESCE_OPERATOR=${FORK_DEPLOY_QUIESCE_OPERATOR:-}
        [[ -n $QUIESCE_OPERATOR ]] || die 'FORK_DEPLOY_QUIESCE_OPERATOR is required for complete test backups'
    else
        QUIESCE_OPERATOR=$PRODUCTION_QUIESCE_OPERATOR
    fi
    validate_absolute_path "$QUIESCE_OPERATOR" 'backup-quiesce operator'
    require_regular_file "$QUIESCE_OPERATOR" 'backup-quiesce operator'
    [[ -x $QUIESCE_OPERATOR ]] || die 'backup-quiesce operator must be executable'
    if ! test_mode; then
        [[ $QUIESCE_OPERATOR == "$PRODUCTION_QUIESCE_OPERATOR" \
            && $(file_owner "$QUIESCE_OPERATOR") == 0:0 \
            && $(file_mode "$QUIESCE_OPERATOR") == 755 ]] \
            || die 'installed backup-quiesce operator identity is invalid'
    fi
}

fd_try_quiesce_release() {
    local output first second third fourth fifth

    [[ -n $QUIESCE_OPERATOR && -n $QUIESCE_OPERATION_ID && -n $QUIESCE_FENCING_TOKEN \
        && -n $QUIESCE_FENCING_TOKEN_SHA256 ]] || return 1
    output=$(CONTROL_PLANE_BACKUP_QUIESCE_OWNER_PID=$$ "$QUIESCE_OPERATOR" backup-quiesce release \
        --operation-id "$QUIESCE_OPERATION_ID" --fencing-token "$QUIESCE_FENCING_TOKEN") \
        || return 1
    [[ $(wc -l <<<"$output" | tr -d '[:space:]') == 1 ]] || return 1
    IFS=';' read -r first second third fourth fifth <<<"$output"
    [[ $first == backup-quiesce=released \
        && $second == "operation_id=$QUIESCE_OPERATION_ID" \
        && $third == "fencing_token_sha256=$QUIESCE_FENCING_TOKEN_SHA256" \
        && $fourth =~ ^released_unix=([1-9][0-9]*)$ && -z $fifth ]] || return 1
    QUIESCE_RELEASED_UNIX=${fourth#*=}
    QUIESCE_ACTIVE=false
}

fd_record_quiesce_release_failure() {
    [[ $QUIESCE_OPERATION_ID =~ ^fork-deploy-[0-9a-f]{24}$ \
        && $QUIESCE_FENCING_TOKEN =~ ^[0-9a-f]{64}$ \
        && $QUIESCE_FENCING_TOKEN_SHA256 == $(printf '%s' "$QUIESCE_FENCING_TOKEN" | sha256sum | awk '{print $1}') \
        && $QUIESCE_ACQUIRED_UNIX =~ ^[1-9][0-9]*$ ]] || return 1
    fd_atomic_write "$QUIESCE_RECOVERY_FILE" 'backup quiesce recovery state' \
        'STATE=quiesce-release-failed' \
        "OPERATOR=$QUIESCE_OPERATOR" \
        "OPERATION_ID=$QUIESCE_OPERATION_ID" \
        "FENCING_TOKEN=$QUIESCE_FENCING_TOKEN" \
        "FENCING_TOKEN_SHA256=$QUIESCE_FENCING_TOKEN_SHA256" \
        "LEASE_ACQUIRED_UNIX=$QUIESCE_ACQUIRED_UNIX" \
        'RECOVERY=Run fork-deploy recover-quiesce before another deploy action.'
}

fd_quiesce_command() {
    local action=$1 output first second third fourth fifth
    local -a arguments=(backup-quiesce "$action" --operation-id "$QUIESCE_OPERATION_ID" \
        --fencing-token "$QUIESCE_FENCING_TOKEN")

    if [[ $action == release ]]; then
        fd_try_quiesce_release || die 'backup-quiesce release failed'
        return
    fi
    [[ $action != acquire ]] || arguments+=(--lease-seconds "$BACKUP_QUIESCE_LEASE_SECONDS")
    output=$(CONTROL_PLANE_BACKUP_QUIESCE_OWNER_PID=$$ "$QUIESCE_OPERATOR" "${arguments[@]}") \
        || die "backup-quiesce $action failed"
    [[ $(wc -l <<<"$output" | tr -d '[:space:]') == 1 ]] \
        || die "backup-quiesce $action emitted unexpected output"
    IFS=';' read -r first second third fourth fifth <<<"$output"
    [[ $second == "operation_id=$QUIESCE_OPERATION_ID" \
        && $third == "fencing_token_sha256=$QUIESCE_FENCING_TOKEN_SHA256" ]] \
        || die "backup-quiesce $action returned the wrong operation identity"
    case $action in
        acquire)
            [[ $first == backup-quiesce=acquired \
                && $fourth =~ ^lease_acquired_unix=([1-9][0-9]*)$ \
                && $fifth =~ ^lease_expires_unix=([1-9][0-9]*)$ ]] \
                || die 'backup-quiesce acquire proof is invalid'
            QUIESCE_ACQUIRED_UNIX=${fourth#*=}
            (( ${fifth#*=} - QUIESCE_ACQUIRED_UNIX == BACKUP_QUIESCE_LEASE_SECONDS )) \
                || die 'backup-quiesce lease differs from the required duration'
            QUIESCE_ACTIVE=true
            ;;
        status)
            [[ $first == backup-quiesce=status-passed \
                && $fourth =~ ^lease_expires_unix=[1-9][0-9]*$ && -z $fifth ]] \
                || die 'backup-quiesce status proof is invalid'
            ;;
        *) die 'unknown backup-quiesce action' ;;
    esac
}

fd_quiesce_cleanup() {
    [[ $QUIESCE_ACTIVE == true ]] || return 0
    if fd_try_quiesce_release; then
        return 0
    fi
    fd_record_quiesce_release_failure || {
        note 'ERROR: backup quiesce release failed and its durable recovery state could not be recorded.' >&2
        return 1
    }
    note "ERROR: backup quiesce release could not be confirmed; run $PROGRAM recover-quiesce before another deploy action." >&2
    return 1
}

fd_backup_capture_cleanup() {
    local backup=${BACKUP_IN_PROGRESS_DIRECTORY:-} relative cleanup_status=0

    fd_quiesce_cleanup || cleanup_status=1
    if [[ $BACKUP_ATTESTED != true && -n $backup ]]; then
        relative=${backup#"$BACKUPS_DIR"/}
        if [[ $backup == "$BACKUPS_DIR"/backup.* && $relative != */* \
            && $relative =~ ^backup\.[1-9][0-9]*\.[A-Za-z0-9]{6}$ ]]; then
            require_directory_or_missing "$backup" 'incomplete deployment backup'
            if [[ -d $backup ]]; then
                fd_assert_tree_safe_for_privileged_mutation "$backup" 'incomplete deployment backup'
                rm -rf -- "$backup"
            fi
        fi
    fi
    return "$cleanup_status"
}

fd_acquire_quiesce() {
    fd_configure_quiesce_operator
    QUIESCE_OPERATION_ID=fork-deploy-$(openssl rand -hex 12)
    QUIESCE_FENCING_TOKEN=$(openssl rand -hex 32)
    [[ $QUIESCE_FENCING_TOKEN =~ ^[0-9a-f]{64}$ ]] \
        || die 'could not generate a backup-quiesce fencing token'
    QUIESCE_FENCING_TOKEN_SHA256=$(printf '%s' "$QUIESCE_FENCING_TOKEN" | sha256sum | awk '{print $1}')
    fd_quiesce_command acquire
    fd_quiesce_command status
}

fd_assert_private_backup_file() {
    local path=$1 label=$2

    require_regular_file "$path" "$label"
    [[ -s $path ]] || die "$label is empty: $path"
    [[ $(file_mode "$path") == 600 ]] || die "$label must have mode 0600: $path"
    if ! test_mode; then
        [[ $(file_owner "$path") == 0:0 ]] || die "$label must be owned by root:root: $path"
    fi
}

fd_assert_private_backup_directory() {
    local path=$1 label=$2

    require_directory_or_missing "$path" "$label"
    [[ -d $path ]] || die "$label is missing: $path"
    [[ $(file_mode "$path") == 700 ]] || die "$label must have mode 0700: $path"
    if ! test_mode; then
        [[ $(file_owner "$path") == 0:0 ]] || die "$label must be owned by root:root: $path"
    fi
}

fd_configuration_record() {
    local manifest=$1 asset=$2

    awk -F= -v wanted="$asset" '
        $1 == wanted { count++; value = substr($0, length($1) + 2) }
        END { if (count != 1) exit 1; print value }
    ' "$manifest" || die "configuration backup manifest is invalid for $asset"
}

fd_validate_configuration_backup() {
    local backup=$1 expected_manifest_sha=$2 manifest record state expected_hash actual_hash asset

    manifest=$backup/configuration.manifest
    fd_assert_private_backup_file "$manifest" 'configuration backup manifest'
    [[ $(sha256sum "$manifest" | awk '{print $1}') == "$expected_manifest_sha" ]] \
        || die 'configuration backup manifest hash differs from its attestation'
    for asset in .env .env.production docker-compose.yml docker-compose.prod.yml docker-compose.custom.yml; do
        record=$(fd_configuration_record "$manifest" "$asset")
        state=${record%%:*}
        expected_hash=${record#*:}
        case $state in
            present)
                validate_digest "sha256:$expected_hash"
                fd_assert_private_backup_file "$backup/$asset" "configuration backup $asset"
                actual_hash=$(sha256sum "$backup/$asset" | awk '{print $1}')
                [[ $actual_hash == "$expected_hash" ]] || die "configuration backup changed: $asset"
                ;;
            absent)
                [[ $expected_hash == none && ! -e $backup/$asset && ! -L $backup/$asset ]] \
                    || die "configuration backup absence record is invalid for $asset"
                ;;
            *) die "configuration backup state is invalid for $asset" ;;
        esac
    done
}

fd_capture_ssh_undo() {
    local backup=$1 undo manifest
    local private_key=$ROOT/ssh/keys/id.root@host.docker.internal
    local public_key authorized_directory=${AUTHORIZED_KEYS%/*}
    local key path destination hash mode owner uid gid

    undo=$backup/prestart-undo
    manifest=$backup/ssh-undo.manifest
    public_key=$private_key.pub

    mkdir "$undo"
    chmod 0700 "$undo"
    : >"$manifest"
    chmod 0600 "$manifest"
    assert_no_symlink_ancestors "$authorized_directory" 'authorized_keys directory'
    if [[ -e $authorized_directory ]]; then
        require_directory_or_missing "$authorized_directory" 'authorized_keys directory'
        mode=$(file_mode "$authorized_directory")
        owner=$(file_owner "$authorized_directory")
        printf 'AUTHORIZED_DIRECTORY=present:%s:%s\n' "$mode" "$owner" >>"$manifest"
    else
        printf 'AUTHORIZED_DIRECTORY=absent:none:none:none\n' >>"$manifest"
    fi
    for key in AUTHORIZED_KEYS PRIVATE_KEY PUBLIC_KEY; do
        case $key in
            AUTHORIZED_KEYS) path=$AUTHORIZED_KEYS; destination=authorized_keys ;;
            PRIVATE_KEY) path=$private_key; destination=localhost-private-key ;;
            PUBLIC_KEY) path=$public_key; destination=localhost-public-key ;;
        esac
        assert_no_symlink_ancestors "$path" "pre-start SSH state $key"
        if [[ -e $path || -L $path ]]; then
            require_regular_file "$path" "pre-start SSH state $key"
            hash=$(sha256sum "$path" | awk '{print $1}')
            mode=$(file_mode "$path")
            owner=$(file_owner "$path")
            uid=${owner%%:*}
            gid=${owner#*:}
            cp -p "$path" "$undo/$destination"
            chmod 0600 "$undo/$destination"
            if ! test_mode; then chown root:root "$undo/$destination"; fi
            printf '%s=present:%s:%s:%s:%s\n' "$key" "$hash" "$mode" "$uid" "$gid" >>"$manifest"
        else
            printf '%s=absent:none:none:none:none\n' "$key" >>"$manifest"
        fi
    done
}

fd_ssh_undo_record() {
    local manifest=$1 key=$2

    awk -F= -v wanted="$key" '
        $1 == wanted { count++; value = substr($0, length($1) + 2) }
        END { if (count != 1) exit 1; print value }
    ' "$manifest" || die "pre-start SSH undo manifest is invalid for $key"
}

fd_validate_prestart_undo() {
    local backup=$1 expected_sha=$2 manifest
    local config_sha ssh_sha record state hash mode uid gid key destination actual directory_record

    manifest=$backup/prestart-undo.manifest
    fd_assert_private_backup_file "$manifest" 'pre-start undo attestation'
    [[ $(sha256sum "$manifest" | awk '{print $1}') == "$expected_sha" ]] \
        || die 'pre-start undo attestation hash changed'
    config_sha=$(read_field "$manifest" CONFIGURATION_MANIFEST_SHA256 'pre-start undo attestation')
    ssh_sha=$(read_field "$manifest" SSH_UNDO_MANIFEST_SHA256 'pre-start undo attestation')
    validate_digest "sha256:$config_sha"
    validate_digest "sha256:$ssh_sha"
    fd_validate_configuration_backup "$backup" "$config_sha"
    fd_assert_private_backup_file "$backup/ssh-undo.manifest" 'pre-start SSH undo manifest'
    [[ $(sha256sum "$backup/ssh-undo.manifest" | awk '{print $1}') == "$ssh_sha" ]] \
        || die 'pre-start SSH undo manifest hash changed'
    directory_record=$(fd_ssh_undo_record "$backup/ssh-undo.manifest" AUTHORIZED_DIRECTORY)
    IFS=: read -r state mode uid gid <<<"$directory_record"
    case $state in
        present)
            [[ $mode =~ ^[0-7]{3,4}$ && $uid =~ ^[0-9]+$ && $gid =~ ^[0-9]+$ ]] \
                || die 'pre-start authorized_keys directory metadata is invalid'
            ;;
        absent)
            [[ $mode == none && $uid == none && $gid == none ]] \
                || die 'pre-start authorized_keys directory absence record is invalid'
            ;;
        *) die 'pre-start authorized_keys directory state is invalid' ;;
    esac
    for key in AUTHORIZED_KEYS PRIVATE_KEY PUBLIC_KEY; do
        record=$(fd_ssh_undo_record "$backup/ssh-undo.manifest" "$key")
        IFS=: read -r state hash mode uid gid <<<"$record"
        case $key in
            AUTHORIZED_KEYS) destination=authorized_keys ;;
            PRIVATE_KEY) destination=localhost-private-key ;;
            PUBLIC_KEY) destination=localhost-public-key ;;
        esac
        case $state in
            present)
                validate_digest "sha256:$hash"
                [[ $mode =~ ^[0-7]{3,4}$ && $uid =~ ^[0-9]+$ && $gid =~ ^[0-9]+$ ]] \
                    || die "pre-start SSH metadata is invalid for $key"
                require_regular_file "$backup/prestart-undo/$destination" "pre-start SSH undo $key"
                [[ $(file_mode "$backup/prestart-undo/$destination") == 600 ]] \
                    || die "pre-start SSH undo copy must have mode 0600 for $key"
                actual=$(sha256sum "$backup/prestart-undo/$destination" | awk '{print $1}')
                [[ $actual == "$hash" ]] || die "pre-start SSH undo copy changed for $key"
                ;;
            absent)
                [[ $hash == none && $mode == none && $uid == none && $gid == none \
                    && ! -e $backup/prestart-undo/$destination \
                    && ! -L $backup/prestart-undo/$destination ]] \
                    || die "pre-start SSH absence record is invalid for $key"
                ;;
            *) die "pre-start SSH state is invalid for $key" ;;
        esac
    done
}

fd_restore_ssh_undo() {
    local backup=$1 manifest record state hash mode uid gid
    local key source destination authorized_directory=${AUTHORIZED_KEYS%/*} directory_record directory_state

    manifest=$backup/ssh-undo.manifest
    for key in AUTHORIZED_KEYS PRIVATE_KEY PUBLIC_KEY; do
        record=$(fd_ssh_undo_record "$manifest" "$key")
        IFS=: read -r state hash mode uid gid <<<"$record"
        case $key in
            AUTHORIZED_KEYS) source=$backup/prestart-undo/authorized_keys; destination=$AUTHORIZED_KEYS ;;
            PRIVATE_KEY) source=$backup/prestart-undo/localhost-private-key; destination=$ROOT/ssh/keys/id.root@host.docker.internal ;;
            PUBLIC_KEY) source=$backup/prestart-undo/localhost-public-key; destination=$ROOT/ssh/keys/id.root@host.docker.internal.pub ;;
        esac
        case $state in
            present)
                fd_atomic_copy "$source" "$destination" "restore pre-start SSH state $key"
                chown "$uid:$gid" "$destination"
                chmod "$mode" "$destination"
                ;;
            absent) fd_remove_file "$destination" "restore absent pre-start SSH state $key" ;;
            *) die "pre-start SSH state is invalid for $key" ;;
        esac
    done
    directory_record=$(fd_ssh_undo_record "$manifest" AUTHORIZED_DIRECTORY)
    IFS=: read -r directory_state mode uid gid <<<"$directory_record"
    case $directory_state in
        present)
            chown "$uid:$gid" "$authorized_directory"
            chmod "$mode" "$authorized_directory"
            ;;
        absent)
            rmdir "$authorized_directory" 2>/dev/null \
                || die 'could not remove the authorized_keys directory created by the aborted deployment'
            ;;
        *) die 'pre-start authorized_keys directory state is invalid' ;;
    esac
}

fd_create_configuration_archive() {
    local backup=$1 plaintext asset
    local -a members=(configuration.manifest ssh-undo.manifest prestart-undo.manifest prestart-undo)

    plaintext=$backup/configuration.tar
    for asset in .env .env.production docker-compose.yml docker-compose.prod.yml docker-compose.custom.yml; do
        [[ ! -e $backup/$asset && ! -L $backup/$asset ]] || members+=("$asset")
    done
    tar --create --file "$plaintext" --directory "$backup" "${members[@]}" \
        || die 'configuration recovery archive capture failed'
    chmod 0600 "$plaintext"
    tar --list --file "$plaintext" >/dev/null \
        || die 'configuration recovery archive failed structural validation'
    fd_encrypt_artifact "$plaintext" "$backup/configuration.tar.gpg" 'configuration recovery archive'
}

fd_redis_cli() {
    docker exec coolify-redis sh -eu -c '
        exec env REDISCLI_AUTH="$REDIS_PASSWORD" redis-cli --no-auth-warning --raw \
            -h 127.0.0.1 -p 6379 "$@"
    ' sh "$@"
}

fd_capture_database_backup() {
    local backup=$1 environment=$2 username database dump

    username=$(env_value "$environment" DB_USERNAME)
    database=$(env_value "$environment" DB_DATABASE)
    dump=$backup/database.pgdump
    docker exec --env "PGAPPNAME=fork-deploy-backup" coolify-db \
        pg_dump --no-password --format=custom --compress=9 \
        --username "$username" --dbname "$database" >"$dump" \
        || die 'PostgreSQL backup capture failed'
    chmod 0600 "$dump"
    [[ -s $dump ]] || die 'PostgreSQL backup capture produced an empty archive'
    docker exec --interactive coolify-db pg_restore --list <"$dump" >/dev/null \
        || die 'PostgreSQL backup archive failed structural validation'
}

fd_capture_redis_backup() {
    local backup=$1 snapshot redis_directory redis_filename redis_path

    [[ $(fd_redis_cli SAVE) == OK ]] || die 'Redis synchronous backup capture failed'
    redis_directory=$(fd_redis_cli CONFIG GET dir | sed -n '2p')
    redis_filename=$(fd_redis_cli CONFIG GET dbfilename | sed -n '2p')
    [[ $redis_directory =~ ^/[A-Za-z0-9._/-]+$ \
        && $redis_directory != *'//' && $redis_directory != */../* \
        && $redis_directory != */.. && $redis_directory != *'/./'* \
        && $redis_directory != */. && $redis_directory != *:* \
        && $redis_directory != *$'\n'* && $redis_directory != *$'\r'* \
        && $redis_filename =~ ^[A-Za-z0-9._-]+$ \
        && $redis_filename != . && $redis_filename != .. ]] \
        || die 'Redis backup path is unsafe'
    redis_path=$redis_directory/$redis_filename
    docker exec coolify-redis sh -eu -c 'test -f "$1" && test ! -L "$1"' sh "$redis_path" \
        || die 'Redis source snapshot is not a regular non-symlink file'
    docker exec coolify-redis redis-check-rdb "$redis_path" >/dev/null \
        || die 'Redis source snapshot failed structural validation'
    snapshot=$backup/redis.rdb
    docker cp "coolify-redis:$redis_path" "$snapshot" >/dev/null \
        || die 'Redis backup copy failed'
    chmod 0600 "$snapshot"
    [[ -s $snapshot ]] || die 'Redis backup capture produced an empty snapshot'
}

fd_validate_control_plane_state_tree() {
    local selected discovered

    for selected in applications backups databases proxy sentinel services ssh; do
        require_directory_or_missing "$ROOT/$selected" "control-plane state $selected"
        [[ -d $ROOT/$selected ]] || die "control-plane state directory is missing: $selected"
        discovered=$(find "$ROOT/$selected" -xdev -type l -print -quit)
        [[ -z $discovered ]] || die "control-plane state contains a symbolic link: $discovered"
        discovered=$(find "$ROOT/$selected" -xdev -type f -links +1 -print -quit)
        [[ -z $discovered ]] || die "control-plane state contains a hardlinked file: $discovered"
        if [[ $selected == ssh ]]; then
            while IFS= read -r -d '' discovered; do
                [[ $discovered =~ ^$ROOT/ssh/mux/mux_[a-z0-9]{24}$ ]] \
                    || die "control-plane state contains an ungoverned socket: $discovered"
                if ! test_mode; then
                    [[ $(file_owner "$discovered") == 9999:9999 \
                        && $(file_mode "$discovered") == 600 ]] \
                        || die "control-plane state contains an ungoverned socket: $discovered"
                fi
            done < <(find "$ROOT/$selected" -xdev -type s -print0)
            discovered=$(find "$ROOT/$selected" -xdev ! -type d ! -type f ! -type s -print -quit)
        else
            discovered=$(find "$ROOT/$selected" -xdev ! -type d ! -type f -print -quit)
        fi
        [[ -z $discovered ]] || die "control-plane state contains an unsupported file type: $discovered"
    done
}

fd_capture_control_plane_state() {
    local backup=$1 archive verification

    archive=$backup/control-plane-state.tar
    verification=$backup/.control-plane-state.verify.tar
    fd_validate_control_plane_state_tree
    tar --create --exclude='ssh/mux/mux_*' --file "$archive" --directory "$ROOT" \
        applications backups databases proxy sentinel services ssh \
        || die 'control-plane state backup capture failed'
    chmod 0600 "$archive"
    tar --list --file "$archive" >/dev/null || die 'control-plane state archive failed structural validation'
    fd_validate_control_plane_state_tree
    tar --create --exclude='ssh/mux/mux_*' --file "$verification" --directory "$ROOT" \
        applications backups databases proxy sentinel services ssh \
        || die 'control-plane state verification capture failed'
    chmod 0600 "$verification"
    [[ $(sha256sum "$archive" | awk '{print $1}') == $(sha256sum "$verification" | awk '{print $1}') ]] \
        || die 'control-plane state changed during backup capture'
    rm -f "$verification"
}

fd_validate_redis_backup_structure() {
    local snapshot=$1 container_path

    container_path=/tmp/fork-deploy-validate-$(openssl rand -hex 16).rdb
    docker cp "$snapshot" "coolify-redis:$container_path" >/dev/null \
        || die 'could not stage Redis backup for structural validation'
    if ! docker exec --user 0:0 coolify-redis sh -eu -c \
        'test -f "$1" && test ! -L "$1" && redis-check-rdb "$1" >/dev/null' \
        sh "$container_path"; then
        docker exec --user 0:0 coolify-redis rm -f "$container_path" >/dev/null 2>&1 || true
        die 'Redis backup snapshot failed structural validation'
    fi
    docker exec --user 0:0 coolify-redis rm -f "$container_path" >/dev/null \
        || die 'could not remove the temporary Redis validation snapshot'
}

fd_validate_backup_attestation() {
    local backup=$1 expected_attestation_sha=$2 expected_source=$3 expected_candidate=$4
    local expected_migration=$5 require_complete=$6 require_fresh=${7:-true}
    local attestation created now kind configuration_sha database_sha redis_sha state_sha actual
    local inventory quiesce_operation quiesce_token_sha quiesce_acquired quiesce_released
    local capture_validated capture_validation_sha validation

    validate_digest "sha256:$expected_attestation_sha"
    [[ -n $RECOVERY_RECIPIENT_FINGERPRINT ]] || fd_configure_recovery_key
    fd_assert_private_backup_directory "$backup" 'deployment backup directory'
    attestation=$backup/attestation
    fd_assert_private_backup_file "$attestation" 'deployment backup attestation'
    [[ $(sha256sum "$attestation" | awk '{print $1}') == "$expected_attestation_sha" ]] \
        || die 'deployment backup attestation hash changed'
    [[ $(read_field "$attestation" SCHEMA 'deployment backup attestation') == coolify-fork-backup/v1 ]] \
        || die 'deployment backup attestation schema is invalid'
    [[ $(read_field "$attestation" SOURCE_VERSION 'deployment backup attestation') == "$expected_source" ]] \
        || die 'deployment backup source version changed'
    [[ $(read_field "$attestation" CANDIDATE_VERSION 'deployment backup attestation') == "$expected_candidate" ]] \
        || die 'deployment backup candidate version changed'
    [[ $(read_field "$attestation" MIGRATION_FINGERPRINT_BEFORE 'deployment backup attestation') == "$expected_migration" ]] \
        || die 'deployment backup migration fingerprint changed'
    created=$(read_field "$attestation" CREATED_UNIX 'deployment backup attestation')
    [[ $created =~ ^[1-9][0-9]*$ ]] || die 'deployment backup creation time is invalid'
    now=$(date +%s)
    ((created <= now)) || die 'deployment backup creation time is in the future'
    if [[ $require_fresh == true ]]; then
        ((now - created <= BACKUP_MAX_AGE_SECONDS)) \
            || die 'deployment backup attestation is not fresh'
    fi
    kind=$(read_field "$attestation" BACKUP_KIND 'deployment backup attestation')
    if [[ $require_complete == true ]]; then
        [[ $kind == complete ]] || die 'a complete PostgreSQL, Redis, and control-plane backup is required'
    else
        [[ $kind == complete || $kind == configuration-only ]] \
            || die 'deployment backup kind is invalid'
    fi
    [[ $(read_field "$attestation" RECOVERY_RECIPIENT_FINGERPRINT 'deployment backup attestation') \
        == "$RECOVERY_RECIPIENT_FINGERPRINT" ]] \
        || die 'deployment backup recovery recipient changed'
    [[ $(read_field "$attestation" RETENTION_COUNT 'deployment backup attestation') \
        == "$BACKUP_RETENTION_COUNT" ]] || die 'deployment backup retention policy changed'
    inventory=$(read_field "$attestation" STATE_INVENTORY 'deployment backup attestation')
    [[ $inventory == applications,backups,databases,proxy,sentinel,services,ssh ]] \
        || die 'deployment backup persistent-state inventory is incomplete'
    capture_validated=$(read_field "$attestation" CAPTURE_VALIDATED_UNIX 'deployment backup attestation')
    [[ $capture_validated =~ ^[1-9][0-9]*$ && $capture_validated -ge $created \
        && $capture_validated -le $now ]] \
        || die 'deployment backup capture validation time is invalid'
    capture_validation_sha=$(read_field "$attestation" CAPTURE_VALIDATION_SHA256 'deployment backup attestation')
    configuration_sha=$(read_field "$attestation" CONFIGURATION_ARCHIVE_SHA256 'deployment backup attestation')
    validate_digest "sha256:$configuration_sha"
    fd_validate_encrypted_artifact "$backup/configuration.tar.gpg" "$configuration_sha" \
        'encrypted configuration recovery archive'
    database_sha=$(read_field "$attestation" DATABASE_DUMP_SHA256 'deployment backup attestation')
    redis_sha=$(read_field "$attestation" REDIS_SNAPSHOT_SHA256 'deployment backup attestation')
    state_sha=$(read_field "$attestation" CONTROL_PLANE_STATE_SHA256 'deployment backup attestation')
    quiesce_operation=$(read_field "$attestation" QUIESCE_OPERATION_ID 'deployment backup attestation')
    quiesce_token_sha=$(read_field "$attestation" QUIESCE_FENCING_TOKEN_SHA256 'deployment backup attestation')
    quiesce_acquired=$(read_field "$attestation" QUIESCE_ACQUIRED_UNIX 'deployment backup attestation')
    quiesce_released=$(read_field "$attestation" QUIESCE_RELEASED_UNIX 'deployment backup attestation')
    if [[ $kind == configuration-only ]]; then
        [[ $database_sha == none && $redis_sha == none && $state_sha == none \
            && $quiesce_operation == none && $quiesce_token_sha == none \
            && $quiesce_acquired == none && $quiesce_released == none \
            && $capture_validation_sha == none \
            && ! -e $backup/capture-validation && ! -L $backup/capture-validation ]] \
            || die 'configuration-only backup unexpectedly names data artifacts'
        return 0
    fi
    for actual in "$database_sha" "$redis_sha" "$state_sha"; do
        validate_digest "sha256:$actual"
    done
    [[ $quiesce_operation =~ ^fork-deploy-[0-9a-f]{24}$ ]] \
        || die 'deployment backup quiesce operation ID is invalid'
    validate_digest "sha256:$quiesce_token_sha"
    [[ $quiesce_acquired =~ ^[1-9][0-9]*$ && $quiesce_released =~ ^[1-9][0-9]*$ \
        && $quiesce_acquired -ge $created && $capture_validated -ge $quiesce_acquired \
        && $quiesce_released -ge $capture_validated && $quiesce_released -le $now ]] \
        || die 'deployment backup quiesce timing proof is invalid'
    validate_digest "sha256:$capture_validation_sha"
    validation=$backup/capture-validation
    fd_assert_private_backup_file "$validation" 'quiesced capture validation'
    [[ $(sha256sum "$validation" | awk '{print $1}') == "$capture_validation_sha" \
        && $(read_field "$validation" CAPTURE_VALIDATION 'quiesced capture validation') == passed \
        && $(read_field "$validation" CAPTURE_VALIDATED_UNIX 'quiesced capture validation') == "$capture_validated" \
        && $(read_field "$validation" QUIESCE_OPERATION_ID 'quiesced capture validation') == "$quiesce_operation" \
        && $(read_field "$validation" QUIESCE_FENCING_TOKEN_SHA256 'quiesced capture validation') == "$quiesce_token_sha" \
        && $(read_field "$validation" QUIESCE_ACQUIRED_UNIX 'quiesced capture validation') == "$quiesce_acquired" \
        && $(read_field "$validation" CONFIGURATION_ARCHIVE_SHA256 'quiesced capture validation') == "$configuration_sha" \
        && $(read_field "$validation" DATABASE_DUMP_SHA256 'quiesced capture validation') == "$database_sha" \
        && $(read_field "$validation" REDIS_SNAPSHOT_SHA256 'quiesced capture validation') == "$redis_sha" \
        && $(read_field "$validation" CONTROL_PLANE_STATE_SHA256 'quiesced capture validation') == "$state_sha" ]] \
        || die 'quiesced capture validation differs from its final attestation'
    fd_validate_encrypted_artifact "$backup/database.pgdump.gpg" "$database_sha" \
        'encrypted PostgreSQL backup archive'
    fd_validate_encrypted_artifact "$backup/redis.rdb.gpg" "$redis_sha" \
        'encrypted Redis backup snapshot'
    fd_validate_encrypted_artifact "$backup/control-plane-state.tar.gpg" "$state_sha" \
        'encrypted control-plane persistent-state archive'
    [[ ! -e $backup/database.pgdump && ! -e $backup/redis.rdb \
        && ! -e $backup/control-plane-state.tar ]] \
        || die 'plaintext recovery artifacts remain in the deployment backup'
}

fd_create_backup() {
    local migration_before=$1 source_version=$2 require_complete=$3
    local backup manifest asset hash kind created capture_validated configuration_sha
    local database_sha=none redis_sha=none state_sha=none
    local quiesce_operation=none quiesce_token_sha=none quiesce_acquired=none quiesce_released=none
    local capture_validation_sha=none

    created=$(date +%s)
    backup=$(mktemp -d "$BACKUPS_DIR/backup.$created.XXXXXX")
    chmod 0700 "$backup"
    BACKUP_IN_PROGRESS_DIRECTORY=$backup
    BACKUP_ATTESTED=false
    trap 'fd_backup_capture_cleanup' EXIT
    trap 'fd_backup_capture_cleanup; exit 129' HUP
    trap 'fd_backup_capture_cleanup; exit 130' INT
    trap 'fd_backup_capture_cleanup; exit 143' TERM
    fd_configure_recovery_key
    manifest=$backup/configuration.manifest
    : >"$manifest"
    chmod 0600 "$manifest"
    require_directory_or_missing "$SOURCE_DIR" 'Coolify source directory'
    for asset in .env .env.production docker-compose.yml docker-compose.prod.yml docker-compose.custom.yml; do
        if [[ -e $SOURCE_DIR/$asset || -L $SOURCE_DIR/$asset ]]; then
            require_regular_file "$SOURCE_DIR/$asset" "existing source asset $asset"
            cp -p "$SOURCE_DIR/$asset" "$backup/$asset"
            chmod 0600 "$backup/$asset"
            hash=$(sha256sum "$backup/$asset" | awk '{print $1}')
            printf '%s=present:%s\n' "$asset" "$hash" >>"$manifest"
        else
            printf '%s=absent:none\n' "$asset" >>"$manifest"
        fi
    done
    fd_capture_ssh_undo "$backup"
    {
        printf 'CONFIGURATION_MANIFEST_SHA256=%s\n' "$(sha256sum "$manifest" | awk '{print $1}')"
        printf 'SSH_UNDO_MANIFEST_SHA256=%s\n' "$(sha256sum "$backup/ssh-undo.manifest" | awk '{print $1}')"
    } >"$backup/prestart-undo.manifest"
    chmod 0600 "$backup/prestart-undo.manifest"
    if ! test_mode; then
        chown -R root:root "$backup"
    fi
    fd_validate_prestart_undo "$backup" \
        "$(sha256sum "$backup/prestart-undo.manifest" | awk '{print $1}')"
    fd_create_configuration_archive "$backup"
    configuration_sha=$(sha256sum "$backup/configuration.tar.gpg" | awk '{print $1}')
    kind=configuration-only
    if [[ $require_complete == true ]]; then
        kind=complete
        fd_acquire_quiesce
        fd_capture_database_backup "$backup" "$SOURCE_DIR/.env"
        fd_quiesce_command status
        fd_capture_redis_backup "$backup"
        fd_quiesce_command status
        fd_capture_control_plane_state "$backup"
        fd_quiesce_command status
        fd_validate_redis_backup_structure "$backup/redis.rdb"
        fd_encrypt_artifact "$backup/database.pgdump" "$backup/database.pgdump.gpg" \
            'PostgreSQL backup archive'
        fd_encrypt_artifact "$backup/redis.rdb" "$backup/redis.rdb.gpg" \
            'Redis backup snapshot'
        fd_encrypt_artifact "$backup/control-plane-state.tar" \
            "$backup/control-plane-state.tar.gpg" 'control-plane persistent-state archive'
        fd_quiesce_command status
        database_sha=$(sha256sum "$backup/database.pgdump.gpg" | awk '{print $1}')
        redis_sha=$(sha256sum "$backup/redis.rdb.gpg" | awk '{print $1}')
        state_sha=$(sha256sum "$backup/control-plane-state.tar.gpg" | awk '{print $1}')
        capture_validated=$(date +%s)
        quiesce_operation=$QUIESCE_OPERATION_ID
        quiesce_token_sha=$QUIESCE_FENCING_TOKEN_SHA256
        quiesce_acquired=$QUIESCE_ACQUIRED_UNIX
        {
            printf 'CAPTURE_VALIDATION=passed\n'
            printf 'CAPTURE_VALIDATED_UNIX=%s\n' "$capture_validated"
            printf 'QUIESCE_OPERATION_ID=%s\n' "$quiesce_operation"
            printf 'QUIESCE_FENCING_TOKEN_SHA256=%s\n' "$quiesce_token_sha"
            printf 'QUIESCE_ACQUIRED_UNIX=%s\n' "$quiesce_acquired"
            printf 'CONFIGURATION_ARCHIVE_SHA256=%s\n' "$configuration_sha"
            printf 'DATABASE_DUMP_SHA256=%s\n' "$database_sha"
            printf 'REDIS_SNAPSHOT_SHA256=%s\n' "$redis_sha"
            printf 'CONTROL_PLANE_STATE_SHA256=%s\n' "$state_sha"
        } >"$backup/capture-validation"
        chmod 0600 "$backup/capture-validation"
        fd_assert_private_backup_file "$backup/capture-validation" 'quiesced capture validation'
        capture_validation_sha=$(sha256sum "$backup/capture-validation" | awk '{print $1}')
        fd_quiesce_command status
        fd_quiesce_command release
        quiesce_released=$QUIESCE_RELEASED_UNIX
    else
        capture_validated=$(date +%s)
    fi
    {
        printf 'SCHEMA=coolify-fork-backup/v1\n'
        printf 'CREATED_UNIX=%s\n' "$created"
        printf 'SOURCE_VERSION=%s\n' "$source_version"
        printf 'CANDIDATE_VERSION=%s\n' "$VERSION"
        printf 'MIGRATION_FINGERPRINT_BEFORE=%s\n' "$migration_before"
        printf 'BACKUP_KIND=%s\n' "$kind"
        printf 'RECOVERY_RECIPIENT_FINGERPRINT=%s\n' "$RECOVERY_RECIPIENT_FINGERPRINT"
        printf 'RETENTION_COUNT=%s\n' "$BACKUP_RETENTION_COUNT"
        printf 'STATE_INVENTORY=applications,backups,databases,proxy,sentinel,services,ssh\n'
        printf 'CAPTURE_VALIDATED_UNIX=%s\n' "$capture_validated"
        printf 'CAPTURE_VALIDATION_SHA256=%s\n' "$capture_validation_sha"
        printf 'QUIESCE_OPERATION_ID=%s\n' "$quiesce_operation"
        printf 'QUIESCE_FENCING_TOKEN_SHA256=%s\n' "$quiesce_token_sha"
        printf 'QUIESCE_ACQUIRED_UNIX=%s\n' "$quiesce_acquired"
        printf 'QUIESCE_RELEASED_UNIX=%s\n' "$quiesce_released"
        printf 'CONFIGURATION_ARCHIVE_SHA256=%s\n' "$configuration_sha"
        printf 'DATABASE_DUMP_SHA256=%s\n' "$database_sha"
        printf 'REDIS_SNAPSHOT_SHA256=%s\n' "$redis_sha"
        printf 'CONTROL_PLANE_STATE_SHA256=%s\n' "$state_sha"
    } >"$backup/attestation"
    chmod 0600 "$backup/attestation"
    if ! test_mode; then
        chown -R root:root "$backup"
    fi
    hash=$(sha256sum "$backup/attestation" | awk '{print $1}')
    fd_validate_backup_attestation "$backup" "$hash" "$source_version" "$VERSION" \
        "$migration_before" "$require_complete" true
    fd_validate_prestart_undo "$backup" \
        "$(sha256sum "$backup/prestart-undo.manifest" | awk '{print $1}')"
    BACKUP_ATTESTED=true
    BACKUP_IN_PROGRESS_DIRECTORY=
    trap - EXIT HUP INT TERM
    printf '%s\n' "$backup"
}

fd_restore_backup() {
    local backup=$1 asset record state

    ensure_secure_directory "$SOURCE_DIR" 'Coolify source directory'
    for asset in .env .env.production docker-compose.yml docker-compose.prod.yml docker-compose.custom.yml; do
        record=$(fd_configuration_record "$backup/configuration.manifest" "$asset")
        state=${record%%:*}
        case $state in
            present) fd_atomic_copy "$backup/$asset" "$SOURCE_DIR/$asset" "restore $asset" ;;
            absent) fd_remove_file "$SOURCE_DIR/$asset" "restore $asset" ;;
            *) die "configuration backup state is invalid for $asset" ;;
        esac
    done
    fd_restore_ssh_undo "$backup"
}

fd_remove_prestart_undo_plaintext() {
    local backup=$1 asset undo_directory=$1/prestart-undo

    if [[ -e $undo_directory || -L $undo_directory ]]; then
        require_directory_or_missing "$undo_directory" 'pre-start SSH undo directory'
        for asset in authorized_keys localhost-private-key localhost-public-key; do
            fd_remove_file "$undo_directory/$asset" "finalized pre-start SSH undo $asset"
        done
        rmdir "$undo_directory" || die 'could not finalize the pre-start SSH undo directory'
    fi
    for asset in .env .env.production docker-compose.yml docker-compose.prod.yml docker-compose.custom.yml \
        configuration.manifest ssh-undo.manifest prestart-undo.manifest; do
        fd_remove_file "$backup/$asset" "finalized plaintext recovery journal $asset"
    done
}

fd_assert_prestart_undo_finalized() {
    local backup=$1 asset

    [[ ! -e $backup/prestart-undo && ! -L $backup/prestart-undo ]] \
        || die 'pre-start SSH undo directory remains after finalization'
    for asset in .env .env.production docker-compose.yml docker-compose.prod.yml docker-compose.custom.yml \
        configuration.manifest ssh-undo.manifest prestart-undo.manifest; do
        [[ ! -e $backup/$asset && ! -L $backup/$asset ]] \
            || die "plaintext recovery journal remains after finalization: $asset"
    done
}

fd_finalize_prestart_undo() {
    local backup=$1

    fd_validate_prestart_undo "$backup" "$DEPLOYMENT_PRESTART_UNDO_SHA256"
    fd_remove_prestart_undo_plaintext "$backup"
    fd_assert_prestart_undo_finalized "$backup"
}

fd_finish_prestart_undo_finalization() {
    local backup=$1

    # This path is entered only after an atomic durable transition proved that restore succeeded
    # and plaintext cleanup began. It removes only the known recovery-journal paths.
    fd_remove_prestart_undo_plaintext "$backup"
    fd_assert_prestart_undo_finalized "$backup"
}

fd_backup_is_referenced() {
    local backup=$1 state reference

    for state in "$PENDING_FILE" "$FAILED_RESTORE_FILE"; do
        [[ -e $state || -L $state ]] || continue
        require_regular_file "$state" 'deployment recovery state'
        reference=$(read_field "$state" CONFIGURATION_BACKUP 'deployment recovery state')
        [[ $reference != "$backup" ]] || return 0
    done
    return 1
}

fd_prune_backups() {
    local protected=$1 discovered backup count
    local -a candidates=()

    while IFS= read -r discovered; do
        [[ -n $discovered ]] || continue
        backup=$BACKUPS_DIR/$discovered
        [[ $discovered =~ ^backup\.[1-9][0-9]*\.[A-Za-z0-9]{6}$ ]] || continue
        fd_assert_private_backup_directory "$backup" 'retained deployment backup directory'
        fd_assert_private_backup_file "$backup/attestation" 'retained deployment backup attestation'
        candidates+=("$backup")
    done < <(find "$BACKUPS_DIR" -mindepth 1 -maxdepth 1 -type d -print \
        | sed "s#^$BACKUPS_DIR/##" | sort)
    count=${#candidates[@]}
    for backup in "${candidates[@]}"; do
        ((count > BACKUP_RETENTION_COUNT)) || break
        [[ $backup != "$protected" ]] || continue
        fd_backup_is_referenced "$backup" && continue
        fd_assert_tree_safe_for_privileged_mutation "$backup" 'expired deployment backup'
        rm -rf -- "$backup"
        count=$((count - 1))
    done
    ((count <= BACKUP_RETENTION_COUNT)) \
        || die 'backup retention could not safely prune enough completed backups'
}

fd_activate_staging() {
    local staging=$1 asset

    ensure_secure_directory "$SOURCE_DIR" 'Coolify source directory'
    for asset in .env .env.production docker-compose.yml docker-compose.prod.yml docker-compose.custom.yml; do
        fd_atomic_copy "$staging/$asset" "$SOURCE_DIR/$asset" "activate $asset"
    done
}

fd_ensure_network() {
    if ! docker network inspect coolify >/dev/null 2>&1; then
        docker network create coolify >/dev/null || die 'could not create the Coolify Docker network'
    fi
}

fd_validate_runtime_bindings() {
    local app_port soketi_port container bindings runtime_port host_ip host_port app_seen=0 realtime_seen=0 metrics_seen=0

    app_port=$(env_value "$SOURCE_DIR/.env" APP_PORT)
    soketi_port=$(env_value "$SOURCE_DIR/.env" SOKETI_PORT)
    for container in coolify coolify-realtime coolify-db coolify-redis; do
        bindings=$(docker inspect --format '{{range $port, $bindings := .NetworkSettings.Ports}}{{range $binding := $bindings}}{{printf "%s\t%s\t%s\n" $port $binding.HostIp $binding.HostPort}}{{end}}{{end}}' "$container") || {
            note "ERROR: $container is missing" >&2
            return 1
        }
        while IFS=$'\t' read -r runtime_port host_ip host_port; do
            [[ -z $runtime_port ]] && continue
            [[ $host_ip == 127.0.0.1 ]] || {
                note "ERROR: $container $runtime_port binds to unsafe host IP $host_ip" >&2
                return 1
            }
            case "$container:$runtime_port:$host_port" in
                "coolify:8080/tcp:$app_port") app_seen=$((app_seen + 1)) ;;
                "coolify-realtime:6001/tcp:$soketi_port") realtime_seen=$((realtime_seen + 1)) ;;
                'coolify-realtime:6002/tcp:6002') metrics_seen=$((metrics_seen + 1)) ;;
                *)
                    note "ERROR: unexpected published runtime binding $container $runtime_port -> $host_ip:$host_port" >&2
                    return 1
                    ;;
            esac
        done <<<"$bindings"
    done
    [[ $app_seen -eq 1 && $realtime_seen -eq 1 && $metrics_seen -eq 1 ]] || {
        note 'ERROR: runtime bindings are missing or duplicated' >&2
        return 1
    }
}

fd_verify_runtime() {
    local expected actual container platform

    platform=$(host_platform)
    for container in coolify coolify-realtime coolify-db coolify-redis; do
        case $container in
            coolify) expected=$(image_ref_main) ;;
            coolify-realtime) expected=$(image_ref_realtime) ;;
            coolify-db) expected=$(image_ref_postgres) ;;
            coolify-redis) expected=$(image_ref_redis) ;;
        esac
        actual=$(docker inspect --format '{{.Config.Image}}' "$container") || return 1
        [[ $actual == "$expected" ]] || {
            note "ERROR: $container runs $actual, expected $expected" >&2
            return 1
        }
        validate_image_for_host "$expected" "$platform"
    done
    fd_validate_runtime_bindings
    wait_for_health
}

fd_commit_bundle() {
    local staging=$1 dir temporary asset expected actual

    dir=$(fd_release_dir "$VERSION")
    if [[ -e $dir || -L $dir ]]; then
        fd_verify_recorded_bundle "$dir"
        for asset in docker-compose.yml docker-compose.prod.yml docker-compose.custom.yml .env.production release-assets.contract; do
            case $asset in
                docker-compose.yml) expected=$COMPOSE_SHA256 ;;
                docker-compose.prod.yml) expected=$COMPOSE_PROD_SHA256 ;;
                docker-compose.custom.yml) expected=$COMPOSE_OVERLAY_SHA256 ;;
                .env.production) expected=$ENV_PRODUCTION_SHA256 ;;
                release-assets.contract) expected=$RELEASE_ASSET_CONTRACT_SHA256 ;;
            esac
            actual=$(sha256sum "$staging/$asset" | awk '{print $1}')
            [[ $actual == "$expected" ]] || die "candidate $asset differs from the immutable verified release bundle"
        done
        return 0
    fi
    temporary=$(mktemp -d "$RELEASES_DIR/.bundle.$VERSION.XXXXXX")
    chmod 0700 "$temporary"
    for asset in docker-compose.yml docker-compose.prod.yml docker-compose.custom.yml .env.production release-assets.contract; do
        cp -p "$staging/$asset" "$temporary/$asset"
    done
    cp -p "$MANIFEST_PATH" "$temporary/release.manifest"
    cp -p "$MANIFEST_SIGNATURE" "$temporary/release.manifest.sig"
    printf 'VERSION=%s\n' "$VERSION" >"$temporary/verified"
    chmod 0600 "$temporary/verified" "$temporary/release.manifest" "$temporary/release.manifest.sig"
    mv "$temporary" "$dir"
    fd_verify_recorded_bundle "$dir"
}

fd_restore_previous_current() {
    local previous=$1

    [[ -z $previous ]] && return 0
    fd_load_recorded_release "$previous"
    fd_load_activation "$previous"
    fd_atomic_write "$CURRENT_FILE" 'active release state' "$previous"
    if test_mode && [[ ${FORK_DEPLOY_TEST_KILL_AFTER_RESTORE_PREVIOUS_CURRENT:-false} == true ]]; then
        kill -KILL "$BASHPID"
    fi
}

fd_deployment_failure() {
    local code=${1:-1} pending_state='' candidate_version=$VERSION

    if [[ $RECOVERY_ARMED != true || $RECOVERY_HANDLED == true ]]; then
        exit "$code"
    fi
    RECOVERY_HANDLED=true
    RECOVERY_ARMED=false
    trap - ERR
    set +e
    if [[ $CANDIDATE_STARTED == true ]]; then
        fd_remove_file "$CURRENT_FILE" 'active release state' || true
        VERSION=$candidate_version
        fd_write_forward_failure_state || true
        note 'Deployment failed after candidate startup. Snapshot restore and automatic rollback are forbidden because the candidate may have accepted writes.'
        note "Recovery required: run $PROGRAM recover-forward to retry the exact signed candidate without discarding writes."
    fi
    if [[ $CANDIDATE_STARTED != true ]] \
        && (fd_validate_backup_attestation "$DEPLOYMENT_BACKUP" \
            "$DEPLOYMENT_BACKUP_ATTESTATION_SHA256" "$DEPLOYMENT_BACKUP_SOURCE_VERSION" "$candidate_version" \
            "$DEPLOYMENT_MIGRATION_FINGERPRINT" "$DEPLOYMENT_BACKUP_REQUIRE_COMPLETE" false) \
        && (fd_validate_prestart_undo "$DEPLOYMENT_BACKUP" "$DEPLOYMENT_PRESTART_UNDO_SHA256"); then
        if (
            set -e
            fd_write_recover_abort_state recover-abort-restoring "$candidate_version" "$PREVIOUS_CURRENT_VERSION" \
                "$DEPLOYMENT_MIGRATION_FINGERPRINT" "$DEPLOYMENT_BACKUP" \
                "$DEPLOYMENT_BACKUP_ATTESTATION_SHA256" "$DEPLOYMENT_BACKUP_SOURCE_VERSION" \
                "$DEPLOYMENT_PRESTART_UNDO_SHA256" || exit 1
            fd_restore_backup "$DEPLOYMENT_BACKUP" || exit 1
            fd_restore_previous_current "$PREVIOUS_CURRENT_VERSION" || exit 1
            fd_write_recover_abort_state recover-abort-finalizing "$candidate_version" "$PREVIOUS_CURRENT_VERSION" \
                "$DEPLOYMENT_MIGRATION_FINGERPRINT" "$DEPLOYMENT_BACKUP" \
                "$DEPLOYMENT_BACKUP_ATTESTATION_SHA256" "$DEPLOYMENT_BACKUP_SOURCE_VERSION" \
                "$DEPLOYMENT_PRESTART_UNDO_SHA256" || exit 1
            fd_validate_prestart_undo "$DEPLOYMENT_BACKUP" "$DEPLOYMENT_PRESTART_UNDO_SHA256" \
                || exit 1
            fd_write_recover_abort_state recover-abort-cleaning "$candidate_version" "$PREVIOUS_CURRENT_VERSION" \
                "$DEPLOYMENT_MIGRATION_FINGERPRINT" "$DEPLOYMENT_BACKUP" \
                "$DEPLOYMENT_BACKUP_ATTESTATION_SHA256" "$DEPLOYMENT_BACKUP_SOURCE_VERSION" \
                "$DEPLOYMENT_PRESTART_UNDO_SHA256" || exit 1
            fd_finish_prestart_undo_finalization "$DEPLOYMENT_BACKUP" || exit 1
        ); then
            fd_remove_file "$PENDING_FILE" 'pending deployment state' || true
            note 'Deployment failed before candidate startup; the prior configuration was restored without starting any containers.'
        else
            if [[ -e $PENDING_FILE || -L $PENDING_FILE ]]; then
                require_regular_file "$PENDING_FILE" 'pending deployment state'
                pending_state=$(read_field "$PENDING_FILE" STATE 'pending deployment state')
            fi
            case $pending_state in
                recover-abort-restoring|recover-abort-finalizing|recover-abort-cleaning)
                    note "Deployment failed before candidate startup during durable recovery; run $PROGRAM recover-abort."
                    ;;
                *)
                    fd_remove_file "$CURRENT_FILE" 'active release state' || true
                    fd_atomic_write "$FAILED_RESTORE_FILE" 'failed deployment recovery state' 'STATE=failed-needs-restore' "CONFIGURATION_BACKUP=$DEPLOYMENT_BACKUP" 'RECOVERY=Use the control-plane backup/restore operator before any further fork-deploy action.' || true
                    ;;
            esac
        fi
    elif [[ $CANDIDATE_STARTED != true ]]; then
        fd_remove_file "$CURRENT_FILE" 'active release state' || true
        fd_atomic_write "$FAILED_RESTORE_FILE" 'failed deployment recovery state' \
            'STATE=failed-needs-restore' \
            "CANDIDATE_VERSION=$candidate_version" \
            "PREVIOUS_VERSION=$PREVIOUS_CURRENT_VERSION" \
            "MIGRATION_FINGERPRINT_BEFORE=$DEPLOYMENT_MIGRATION_FINGERPRINT" \
            "CONFIGURATION_BACKUP=$DEPLOYMENT_BACKUP" \
            "BACKUP_ATTESTATION_SHA256=$DEPLOYMENT_BACKUP_ATTESTATION_SHA256" \
            "BACKUP_SOURCE_VERSION=$DEPLOYMENT_BACKUP_SOURCE_VERSION" \
            "PRESTART_UNDO_SHA256=$DEPLOYMENT_PRESTART_UNDO_SHA256" \
            'RECOVERY=Use the control-plane backup/restore operator before any further fork-deploy action.' || true
    fi
    exit "$code"
}

deployment_failure() {
    fd_deployment_failure "$@"
}

fd_arm_recovery() {
    RECOVERY_ARMED=true
    RECOVERY_HANDLED=false
    CANDIDATE_STARTED=false
    trap 'fd_deployment_failure $?' ERR
    trap 'fd_deployment_failure 129' HUP
    trap 'fd_deployment_failure 130' INT
    trap 'fd_deployment_failure 143' TERM
}

fd_disarm_recovery() {
    RECOVERY_ARMED=false
    trap - ERR HUP INT TERM
}

fd_rendered_sha() {
    fd_compose_in "$1" config | sha256sum | awk '{print $1}'
}

fd_validate_active_assets() {
    local dir=$1 asset expected actual

    for asset in docker-compose.yml docker-compose.prod.yml docker-compose.custom.yml .env.production; do
        case $asset in
            docker-compose.yml) expected=$COMPOSE_SHA256 ;;
            docker-compose.prod.yml) expected=$COMPOSE_PROD_SHA256 ;;
            docker-compose.custom.yml) expected=$COMPOSE_OVERLAY_SHA256 ;;
            .env.production) expected=$ENV_PRODUCTION_SHA256 ;;
        esac
        require_regular_file "$SOURCE_DIR/$asset" "active source asset $asset"
        actual=$(sha256sum "$SOURCE_DIR/$asset" | awk '{print $1}')
        [[ $actual == "$expected" ]] || die "$asset differs from the verified release; run repair"
    done
}

fd_validate_active_environment() {
    local environment=$SOURCE_DIR/.env

    [[ $(env_value "$environment" AUTOUPDATE) == false ]] || die 'managed environment does not disable automatic updates; run repair'
    [[ $(env_value "$environment" VERSIONS_URL) == "$DISABLED_VERSIONS_URL" ]] || die 'managed environment versions URL is not fail-closed; run repair'
    [[ $(env_value "$environment" UPGRADE_SCRIPT_URL) == "$DISABLED_UPGRADE_SCRIPT_URL" ]] || die 'managed environment upgrade URL is not fail-closed; run repair'
    [[ $(env_value "$environment" RELEASES_URL) == "$DISABLED_RELEASES_URL" ]] || die 'managed environment releases URL are not fail-closed; run repair'
    fd_validate_ports "$environment"
}

fd_require_verified_current() {
    fd_verify_current
}

fd_validate_existing_candidate() {
    local dir=$1 candidate_hash recorded_hash

    [[ ! -e $dir && ! -L $dir ]] && return 0
    require_regular_file "$dir/release.manifest" 'existing release manifest'
    candidate_hash=$(sha256sum "$MANIFEST_PATH" | awk '{print $1}')
    recorded_hash=$(sha256sum "$dir/release.manifest" | awk '{print $1}')
    [[ $candidate_hash == "$recorded_hash" ]] || die "version $VERSION is already bound to a different signed release manifest"
}

fd_validate_update_target() {
    local current=$1 activation comparison

    activation=$(fd_activation_file "$VERSION")
    if [[ -e $activation || -L $activation ]]; then
        require_regular_file "$activation" "activation state for $VERSION"
        die "update refused: $VERSION was already activated; use rollback or repair"
    fi
    comparison=$(fd_version_compare "$VERSION" "$current")
    [[ $comparison == 1 ]] \
        || die "update refused: target $VERSION is not newer than active release $current"
}

fd_write_recover_abort_state() {
    local state=$1 candidate=$2 previous=$3 migration=$4 backup=$5 attestation_sha=$6
    local source_version=$7 prestart_sha=$8

    fd_atomic_write "$PENDING_FILE" 'pending deployment state' \
        "STATE=$state" \
        "CANDIDATE_VERSION=$candidate" \
        "PREVIOUS_VERSION=$previous" \
        "MIGRATION_FINGERPRINT_BEFORE=$migration" \
        "CONFIGURATION_BACKUP=$backup" \
        "BACKUP_ATTESTATION_SHA256=$attestation_sha" \
        "BACKUP_SOURCE_VERSION=$source_version" \
        "PRESTART_UNDO_SHA256=$prestart_sha" \
        'CANDIDATE_STARTED=false'
}

fd_assert_recover_abort_current() {
    local previous=$1 phase=$2 current

    case $phase in
        clear)
            [[ ! -e $CURRENT_FILE && ! -L $CURRENT_FILE ]] \
                || die 'recover-abort requires the active release pointer to remain cleared before restore begins'
            return 0
            ;;
        restoring)
            [[ -e $CURRENT_FILE || -L $CURRENT_FILE ]] || return 0
            ;;
        restored) ;;
        *) die 'recover-abort current-pointer phase is invalid' ;;
    esac
    if [[ -z $previous ]]; then
        [[ ! -e $CURRENT_FILE && ! -L $CURRENT_FILE ]] \
            || die 'recover-abort found an unexpected active release without a previous release'
        return 0
    fi
    current=$(fd_current_version)
    [[ $current == "$previous" ]] \
        || die "recover-abort found active release $current; expected prior release $previous"
}

fd_recover_abort() {
    local state candidate previous migration backup attestation_sha started source_version prestart_sha
    local require_complete=false relative

    if [[ -e $FAILED_RESTORE_FILE || -L $FAILED_RESTORE_FILE ]]; then
        require_regular_file "$FAILED_RESTORE_FILE" 'failed deployment recovery state'
        die "recover-abort and snapshot restore are forbidden after candidate startup; run $PROGRAM recover-forward"
    fi
    require_regular_file "$PENDING_FILE" 'pending deployment state'
    state=$(read_field "$PENDING_FILE" STATE 'pending deployment state')
    case $state in
        pending-candidate|recover-abort-restoring|recover-abort-finalizing|recover-abort-cleaning) ;;
        *) die 'pending deployment state is not recoverable' ;;
    esac
    started=$(read_field "$PENDING_FILE" CANDIDATE_STARTED 'pending deployment state')
    [[ $started == false ]] \
        || die "recover-abort and snapshot restore are forbidden after candidate startup; run $PROGRAM recover-forward"
    candidate=$(read_field "$PENDING_FILE" CANDIDATE_VERSION 'pending deployment state')
    validate_version "$candidate"
    previous=$(read_field "$PENDING_FILE" PREVIOUS_VERSION 'pending deployment state')
    [[ -z $previous ]] || {
        validate_version "$previous"
        require_complete=true
    }
    migration=$(read_field "$PENDING_FILE" MIGRATION_FINGERPRINT_BEFORE 'pending deployment state')
    [[ $migration == uninitialized || $migration =~ ^[0-9a-f]{32}$ ]] \
        || die 'pending deployment migration fingerprint is invalid'
    backup=$(read_field "$PENDING_FILE" CONFIGURATION_BACKUP 'pending deployment state')
    validate_absolute_path "$backup" 'pending deployment backup'
    relative=${backup#"$BACKUPS_DIR"/}
    [[ $backup == "$BACKUPS_DIR"/backup.* && $relative != */* ]] \
        || die 'pending deployment backup is outside the managed backup directory'
    require_directory_or_missing "$backup" 'pending deployment backup'
    [[ -d $backup ]] || die 'pending deployment backup is missing'
    attestation_sha=$(read_field "$PENDING_FILE" BACKUP_ATTESTATION_SHA256 'pending deployment state')
    source_version=$(read_field "$PENDING_FILE" BACKUP_SOURCE_VERSION 'pending deployment state')
    case $source_version in
        unmanaged) require_complete=false ;;
        legacy-unmanaged) require_complete=true ;;
        *) validate_version "$source_version"; require_complete=true ;;
    esac
    prestart_sha=$(read_field "$PENDING_FILE" PRESTART_UNDO_SHA256 'pending deployment state')
    VERSION=$candidate
    DEPLOYMENT_BACKUP=$backup
    DEPLOYMENT_PRESTART_UNDO_SHA256=$prestart_sha
    fd_validate_backup_attestation "$backup" "$attestation_sha" "$source_version" \
        "$candidate" "$migration" "$require_complete" false
    case $state in
        pending-candidate)
            fd_assert_recover_abort_current "$previous" clear
            fd_validate_prestart_undo "$backup" "$prestart_sha"
            fd_write_recover_abort_state recover-abort-restoring "$candidate" "$previous" "$migration" \
                "$backup" "$attestation_sha" "$source_version" "$prestart_sha"
            fd_restore_backup "$backup"
            fd_restore_previous_current "$previous"
            fd_write_recover_abort_state recover-abort-finalizing "$candidate" "$previous" "$migration" \
                "$backup" "$attestation_sha" "$source_version" "$prestart_sha"
            ;;
        recover-abort-restoring)
            fd_assert_recover_abort_current "$previous" restoring
            fd_validate_prestart_undo "$backup" "$prestart_sha"
            fd_restore_backup "$backup"
            fd_restore_previous_current "$previous"
            fd_write_recover_abort_state recover-abort-finalizing "$candidate" "$previous" "$migration" \
                "$backup" "$attestation_sha" "$source_version" "$prestart_sha"
            ;;
    esac
    if [[ $state == pending-candidate || $state == recover-abort-restoring || $state == recover-abort-finalizing ]]; then
        fd_assert_recover_abort_current "$previous" restored
        fd_validate_prestart_undo "$backup" "$prestart_sha"
        fd_write_recover_abort_state recover-abort-cleaning "$candidate" "$previous" "$migration" \
            "$backup" "$attestation_sha" "$source_version" "$prestart_sha"
        fd_finish_prestart_undo_finalization "$backup"
    else
        fd_assert_recover_abort_current "$previous" restored
        fd_finish_prestart_undo_finalization "$backup"
    fi
    fd_remove_file "$PENDING_FILE" 'pending deployment state'
    note 'Recovered the pre-start configuration and cleared the pending candidate without starting containers.'
}

fd_recover_forward() {
    local state candidate previous migration backup attestation_sha source_version prestart_sha
    local pending_started pending_state require_complete=false migration_after rendered field current relative
    local recovery_file='' recovery_label='' failed_present=false pending_present=false
    local legacy_forward_state=false release_directory

    [[ ! -e $QUIESCE_RECOVERY_FILE && ! -L $QUIESCE_RECOVERY_FILE ]] \
        || die 'recover-forward refuses while backup quiesce recovery is also unresolved'
    if [[ -e $FAILED_RESTORE_FILE || -L $FAILED_RESTORE_FILE ]]; then
        require_regular_file "$FAILED_RESTORE_FILE" 'failed deployment recovery state'
        state=$(read_field "$FAILED_RESTORE_FILE" STATE 'failed deployment recovery state')
        case $state in
            failed-needs-forward-recovery) ;;
            failed-needs-restore) legacy_forward_state=true ;;
            *) die 'failed deployment state is not eligible for forward recovery' ;;
        esac
        recovery_file=$FAILED_RESTORE_FILE
        recovery_label='failed deployment recovery state'
        failed_present=true
    fi
    if [[ -e $PENDING_FILE || -L $PENDING_FILE ]]; then
        require_regular_file "$PENDING_FILE" 'pending deployment state'
        pending_state=$(read_field "$PENDING_FILE" STATE 'pending deployment state')
        pending_started=$(read_field "$PENDING_FILE" CANDIDATE_STARTED 'pending deployment state')
        [[ $pending_state == pending-candidate && ( $pending_started == true || $pending_started == false ) ]] \
            || die 'pending deployment state is not eligible for forward recovery'
        if [[ $pending_started == true && -z $recovery_file ]]; then
            recovery_file=$PENDING_FILE
            recovery_label='pending deployment state'
        fi
        pending_present=true
    fi
    [[ -n $recovery_file ]] \
        || die 'forward recovery requires a durable candidate-started or failed-forward disposition'
    if [[ $legacy_forward_state == true \
        && ( $pending_present != true || $pending_started != true ) ]]; then
        candidate=$(read_field "$recovery_file" CANDIDATE_VERSION "$recovery_label")
        validate_version "$candidate"
        if [[ ( -e $(fd_activation_file "$candidate") \
            || -L $(fd_activation_file "$candidate") ) \
            && ( -e $CURRENT_FILE || -L $CURRENT_FILE ) ]]; then
            fd_load_activation "$candidate"
            current=$(fd_current_version)
            [[ $current == "$candidate" ]] \
                || die 'legacy failed state conflicts with the active release; manual recovery is required'
        else
            die 'legacy failed state does not prove candidate startup; snapshot restore is forbidden and manual forward recovery is required'
        fi
    fi
    if [[ $failed_present == true && $pending_present == true ]]; then
        for field in CANDIDATE_VERSION PREVIOUS_VERSION MIGRATION_FINGERPRINT_BEFORE \
            CONFIGURATION_BACKUP BACKUP_ATTESTATION_SHA256 BACKUP_SOURCE_VERSION PRESTART_UNDO_SHA256; do
            [[ $(read_field "$PENDING_FILE" "$field" 'pending deployment state') \
                == $(read_field "$FAILED_RESTORE_FILE" "$field" 'failed deployment recovery state') ]] \
                || die "forward recovery state differs between pending and failed disposition: $field"
        done
    fi

    candidate=$(read_field "$recovery_file" CANDIDATE_VERSION "$recovery_label")
    validate_version "$candidate"
    previous=$(read_field "$recovery_file" PREVIOUS_VERSION "$recovery_label")
    [[ -z $previous ]] || validate_version "$previous"
    migration=$(read_field "$recovery_file" MIGRATION_FINGERPRINT_BEFORE "$recovery_label")
    [[ $migration == uninitialized || $migration =~ ^[0-9a-f]{32}$ ]] \
        || die 'failed deployment migration fingerprint is invalid'
    backup=$(read_field "$recovery_file" CONFIGURATION_BACKUP "$recovery_label")
    validate_absolute_path "$backup" 'failed deployment backup'
    relative=${backup#"$BACKUPS_DIR"/}
    [[ $backup == "$BACKUPS_DIR"/backup.* && $relative != */* ]] \
        || die 'failed deployment backup is outside the managed backup directory'
    attestation_sha=$(read_field "$recovery_file" BACKUP_ATTESTATION_SHA256 "$recovery_label")
    source_version=$(read_field "$recovery_file" BACKUP_SOURCE_VERSION "$recovery_label")
    prestart_sha=$(read_field "$recovery_file" PRESTART_UNDO_SHA256 "$recovery_label")
    case $source_version in
        unmanaged) require_complete=false ;;
        legacy-unmanaged) require_complete=true ;;
        *) validate_version "$source_version"; require_complete=true ;;
    esac

    VERSION=$candidate
    PREVIOUS_CURRENT_VERSION=$previous
    DEPLOYMENT_MIGRATION_FINGERPRINT=$migration
    DEPLOYMENT_BACKUP=$backup
    DEPLOYMENT_BACKUP_ATTESTATION_SHA256=$attestation_sha
    DEPLOYMENT_BACKUP_SOURCE_VERSION=$source_version
    DEPLOYMENT_BACKUP_REQUIRE_COMPLETE=$require_complete
    DEPLOYMENT_PRESTART_UNDO_SHA256=$prestart_sha
    release_directory=$(fd_release_dir "$candidate")
    if [[ $legacy_forward_state == true \
        && ! -f $release_directory/verified ]]; then
        die 'legacy candidate bundle was not durably recorded; snapshot restore is forbidden and manual forward recovery is required'
    fi
    fd_load_recorded_release "$candidate"
    fd_validate_backup_attestation "$backup" "$attestation_sha" "$source_version" \
        "$candidate" "$migration" "$require_complete" false
    fd_write_forward_failure_state
    fd_write_candidate_started_pending
    if [[ -e $CURRENT_FILE || -L $CURRENT_FILE ]]; then
        current=$(fd_current_version)
        [[ $current == "$candidate" ]] \
            || die "forward recovery found active release $current; expected candidate $candidate"
    fi
    [[ $(env_value "$SOURCE_DIR/.env" COOLIFY_FORK_VERSION) == "$candidate" ]] \
        || die 'active environment does not identify the exact failed candidate'
    fd_validate_active_assets "$(fd_release_dir "$candidate")"
    fd_validate_active_environment
    fd_validate_effective_images "$SOURCE_DIR"
    fd_validate_effective_bindings "$SOURCE_DIR"
    fd_compose_in "$SOURCE_DIR" config --quiet || die 'failed candidate Compose configuration is invalid'
    # A durable forward disposition makes every pre-start restore path permanently ineligible.
    # Cleanup may have been interrupted after removing any individual journal entry, so resume by
    # deleting only the fixed, known plaintext paths rather than requiring an all-or-nothing state.
    fd_finish_prestart_undo_finalization "$backup"

    fd_ensure_network
    fd_compose_in "$SOURCE_DIR" up --detach --remove-orphans
    fd_verify_runtime
    migration_after=$(fd_migration_fingerprint "$SOURCE_DIR/.env")
    rendered=$(fd_rendered_sha "$SOURCE_DIR")
    fd_reconcile_forward_activation "$migration" "$migration_after" "$rendered"
    enforce_data_permissions
    fd_prune_backups "$backup"
    fd_remove_file "$PENDING_FILE" 'pending deployment state'
    fd_remove_file "$FAILED_RESTORE_FILE" 'failed deployment recovery state'
    note "Recovered $candidate forward from its exact signed bundle without restoring the pre-start snapshot."
}

fd_recover_quiesce() {
    local state operator operation token token_sha acquired

    [[ ! -e $PENDING_FILE && ! -L $PENDING_FILE && ! -e $FAILED_RESTORE_FILE && ! -L $FAILED_RESTORE_FILE ]] \
        || die 'recover-quiesce refuses while a deployment recovery state is also present'
    require_regular_file "$QUIESCE_RECOVERY_FILE" 'backup quiesce recovery state'
    state=$(read_field "$QUIESCE_RECOVERY_FILE" STATE 'backup quiesce recovery state')
    [[ $state == quiesce-release-failed ]] \
        || die 'backup quiesce recovery state is invalid'
    fd_configure_quiesce_operator
    operator=$(read_field "$QUIESCE_RECOVERY_FILE" OPERATOR 'backup quiesce recovery state')
    [[ $operator == "$QUIESCE_OPERATOR" ]] \
        || die 'backup quiesce recovery operator differs from the installed operator'
    operation=$(read_field "$QUIESCE_RECOVERY_FILE" OPERATION_ID 'backup quiesce recovery state')
    token=$(read_field "$QUIESCE_RECOVERY_FILE" FENCING_TOKEN 'backup quiesce recovery state')
    token_sha=$(read_field "$QUIESCE_RECOVERY_FILE" FENCING_TOKEN_SHA256 'backup quiesce recovery state')
    acquired=$(read_field "$QUIESCE_RECOVERY_FILE" LEASE_ACQUIRED_UNIX 'backup quiesce recovery state')
    [[ $operation =~ ^fork-deploy-[0-9a-f]{24}$ && $token =~ ^[0-9a-f]{64}$ \
        && $token_sha == $(printf '%s' "$token" | sha256sum | awk '{print $1}') \
        && $acquired =~ ^[1-9][0-9]*$ ]] \
        || die 'backup quiesce recovery state is malformed'
    QUIESCE_OPERATION_ID=$operation
    QUIESCE_FENCING_TOKEN=$token
    QUIESCE_FENCING_TOKEN_SHA256=$token_sha
    QUIESCE_ACQUIRED_UNIX=$acquired
    QUIESCE_ACTIVE=true
    fd_try_quiesce_release \
        || die 'backup quiesce release remains unresolved; inspect the operator and retry recover-quiesce'
    fd_remove_file "$QUIESCE_RECOVERY_FILE" 'backup quiesce recovery state'
    note 'Released the durable backup-quiesce recovery fence.'
}

fd_start_candidate() {
    local staging=$1 migration_before=$2 record_bundle=$3 migration_after rendered

    if [[ -e $CURRENT_FILE || -L $CURRENT_FILE ]]; then
        PREVIOUS_CURRENT_VERSION=$(fd_current_version)
    else
        PREVIOUS_CURRENT_VERSION=
    fi
    DEPLOYMENT_MIGRATION_FINGERPRINT=$migration_before
    fd_classify_backup_requirement
    DEPLOYMENT_BACKUP=$(fd_create_backup "$migration_before" \
        "$DEPLOYMENT_BACKUP_SOURCE_VERSION" "$DEPLOYMENT_BACKUP_REQUIRE_COMPLETE")
    DEPLOYMENT_BACKUP_ATTESTATION_SHA256=$(sha256sum "$DEPLOYMENT_BACKUP/attestation" | awk '{print $1}')
    DEPLOYMENT_PRESTART_UNDO_SHA256=$(sha256sum "$DEPLOYMENT_BACKUP/prestart-undo.manifest" | awk '{print $1}')
    fd_validate_backup_attestation "$DEPLOYMENT_BACKUP" \
        "$DEPLOYMENT_BACKUP_ATTESTATION_SHA256" "$DEPLOYMENT_BACKUP_SOURCE_VERSION" "$VERSION" \
        "$migration_before" "$DEPLOYMENT_BACKUP_REQUIRE_COMPLETE" true
    fd_validate_prestart_undo "$DEPLOYMENT_BACKUP" "$DEPLOYMENT_PRESTART_UNDO_SHA256"
    fd_arm_recovery
    fd_mark_pending
    adopt_localhost_ssh_key
    fd_activate_staging "$staging"
    fd_ensure_network
    fd_compose_in "$SOURCE_DIR" config --quiet || die 'activated Compose configuration is invalid'
    fd_validate_backup_attestation "$DEPLOYMENT_BACKUP" \
        "$DEPLOYMENT_BACKUP_ATTESTATION_SHA256" "$DEPLOYMENT_BACKUP_SOURCE_VERSION" "$VERSION" \
        "$migration_before" "$DEPLOYMENT_BACKUP_REQUIRE_COMPLETE" true
    fd_validate_prestart_undo "$DEPLOYMENT_BACKUP" "$DEPLOYMENT_PRESTART_UNDO_SHA256"
    [[ $record_bundle == true ]] && fd_commit_bundle "$staging"
    fd_mark_candidate_started
    fd_finalize_prestart_undo "$DEPLOYMENT_BACKUP"
    fd_compose_in "$SOURCE_DIR" up --detach --remove-orphans
    fd_verify_runtime
    migration_after=$(fd_migration_fingerprint "$SOURCE_DIR/.env")
    rendered=$(fd_rendered_sha "$SOURCE_DIR")
    fd_write_activation "$migration_before" "$migration_after" "$rendered"
    enforce_data_permissions
    fd_prune_backups "$DEPLOYMENT_BACKUP"
    fd_remove_file "$PENDING_FILE" 'pending deployment state'
    fd_remove_file "$FAILED_RESTORE_FILE" 'failed deployment recovery state'
    fd_disarm_recovery
    rm -rf "$staging"
}

fd_deploy_new() {
    local platform staging migration_before release_directory

    platform=$(host_platform)
    validate_image_for_host "$(image_ref_main)" "$platform"
    validate_image_for_host "$(image_ref_realtime)" "$platform"
    validate_image_for_host "$(image_ref_postgres)" "$platform"
    validate_image_for_host "$(image_ref_redis)" "$platform"
    if "$DRY_RUN"; then
        note "PLAN: verify signed manifest, stage all assets and environment, then atomically activate release $VERSION"
        return 0
    fi
    release_directory=$(fd_release_dir "$VERSION")
    fd_validate_existing_candidate "$release_directory"
    if [[ ! -e $CURRENT_FILE && ! -L $CURRENT_FILE ]]; then
        fd_snapshot_unmanaged_layout
    fi
    bootstrap_directories
    staging=$(fd_new_staging)
    fd_stage_remote "$staging"
    migration_before=$(fd_migration_fingerprint "$staging/.env")
    fd_start_candidate "$staging" "$migration_before" true
    note "Verified and recorded $VERSION. Roll back with: $PROGRAM rollback --version $VERSION"
}

fd_deploy_recorded() {
    local target=$VERSION staging migration_before compatible

    fd_load_recorded_release "$target"
    fd_load_activation "$target"
    migration_before=$(fd_migration_fingerprint "$SOURCE_DIR/.env")
    compatible=$(fd_activation_field "$target" MIGRATION_FINGERPRINT_AFTER)
    if [[ $ACTION == rollback && $migration_before != "$compatible" ]]; then
        die "rollback refused: current migration fingerprint $migration_before is not explicitly compatible with target $target ($compatible). Use the control-plane backup/restore operator for a schema-changing rollback"
    fi
    if [[ $ACTION == repair && $migration_before != "$compatible" ]]; then
        die 'repair refused: current migration fingerprint differs from the verified release; use the control-plane backup/restore operator'
    fi
    if "$DRY_RUN"; then
        note "PLAN: validate and atomically activate verified release $target, then start and verify it"
        return 0
    fi
    bootstrap_directories
    staging=$(fd_new_staging)
    fd_stage_recorded "$staging"
    fd_start_candidate "$staging" "$migration_before" false
}

fd_status() {
    local current manifest line

    if [[ -e $QUIESCE_RECOVERY_FILE || -L $QUIESCE_RECOVERY_FILE ]]; then
        require_regular_file "$QUIESCE_RECOVERY_FILE" 'backup quiesce recovery state'
        note 'Fork deploy backup-quiesce recovery state:'
        while IFS= read -r line; do
            case $line in
                FENCING_TOKEN=*) note '  FENCING_TOKEN=[redacted]' ;;
                *) note "  $line" ;;
            esac
        done <"$QUIESCE_RECOVERY_FILE"
        return 1
    fi
    if [[ -e $FAILED_RESTORE_FILE || -L $FAILED_RESTORE_FILE ]]; then
        require_regular_file "$FAILED_RESTORE_FILE" 'failed deployment recovery state'
        note 'Fork deploy recovery state:'
        while IFS= read -r line; do note "  $line"; done <"$FAILED_RESTORE_FILE"
        return 1
    fi
    if [[ -e $PENDING_FILE || -L $PENDING_FILE ]]; then
        require_regular_file "$PENDING_FILE" 'pending deployment state'
        note 'Fork deploy pending state:'
        while IFS= read -r line; do note "  $line"; done <"$PENDING_FILE"
        return 1
    fi
    if [[ ! -e $CURRENT_FILE && ! -L $CURRENT_FILE ]]; then
        note 'Fork deploy status: unmanaged (no verified release recorded)'
        return 1
    fi
    current=$(fd_current_version)
    fd_load_recorded_release "$current"
    manifest=$(fd_release_dir "$current")/release.manifest
    note "Fork deploy version: $current"
    note "Source revision: $(read_field "$manifest" SOURCE_REVISION 'recorded release manifest')"
    note "Main digest: $MAIN_DIGEST"
    note "Realtime digest: $REALTIME_DIGEST"
    docker ps --filter name='^/coolify' --format '{{.Names}} {{.Status}}' || true
}

fd_verify_current() {
    local current dir rendered migrations

    current=$(fd_current_version)
    fd_load_recorded_release "$current"
    fd_load_activation "$current"
    dir=$(fd_release_dir "$current")
    fd_validate_active_assets "$dir"
    fd_validate_active_environment
    rendered=$(fd_rendered_sha "$SOURCE_DIR")
    [[ $rendered == "$(fd_activation_field "$current" RENDERED_COMPOSE_SHA256)" ]] || die 'effective rendered Compose differs from the active verified state; run repair'
    fd_validate_effective_images "$SOURCE_DIR"
    fd_validate_effective_bindings "$SOURCE_DIR"
    migrations=$(fd_migration_fingerprint "$SOURCE_DIR/.env")
    [[ $migrations == "$(fd_activation_field "$current" MIGRATION_FINGERPRINT_AFTER)" ]] || die 'database migration fingerprint differs from the active verified state; investigate before update or rollback'
    fd_verify_runtime
    note "Release $current is healthy and matches its immutable verified bundle and active state."
}

main() {
    [[ -n ${BASH_VERSION:-} ]] || die 'this script requires Bash'
    fd_parse_args "$@"
    if [[ $ACTION == trust ]]; then
        fd_preflight_trust
        fd_install_production_trust_key "$TRUST_PUBLIC_KEY"
        return
    fi
    configure_paths
    if [[ $ACTION == recover-quiesce ]]; then
        recover_quiesce_preflight
        acquire_lock
        fd_recover_quiesce
        return
    fi
    preflight
    acquire_lock
    fd_configure_manifest_trust
    case $ACTION in
        install)
            fd_ensure_no_unresolved
            [[ ! -e $CURRENT_FILE && ! -L $CURRENT_FILE ]] || die 'a managed release already exists; use update'
            fd_download_manifest
            fd_load_manifest
            fd_deploy_new
            ;;
        update)
            fd_ensure_no_unresolved
            fd_require_verified_current
            UPDATE_FROM_VERSION=$(fd_current_version)
            fd_download_manifest
            fd_load_manifest
            fd_validate_update_target "$UPDATE_FROM_VERSION"
            fd_deploy_new
            ;;
        rollback)
            fd_ensure_no_unresolved
            fd_deploy_recorded
            ;;
        repair)
            fd_ensure_no_unresolved
            VERSION=$(fd_current_version)
            ACTION=repair
            fd_deploy_recorded
            ;;
        recover-abort) fd_recover_abort ;;
        recover-forward) fd_recover_forward ;;
        status) fd_status ;;
        verify)
            fd_ensure_no_unresolved
            fd_verify_current
            ;;
    esac
}

main "$@"
